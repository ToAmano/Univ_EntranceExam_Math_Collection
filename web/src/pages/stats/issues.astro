---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { readIssueIndex } from '../../lib/issues.mjs';
import { buildIssueStats, KIND_META } from '../../lib/issue-stats.mjs';
import { buildBreadcrumbListJsonLd } from '../../utils/seo';

const allSolutions = await getCollection('solutions');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const issueIndex = readIssueIndex();
const stats = buildIssueStats(issueIndex, allSolutions, baseUrl);

const checkedAt = stats.generatedAt
	? new Date(stats.generatedAt).toLocaleString('ja-JP', {
			timeZone: 'Asia/Tokyo',
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
			hour: '2-digit',
			minute: '2-digit',
		})
	: null;

const breadcrumbJsonLd = buildBreadcrumbListJsonLd([
	{ name: 'トップ', url: new URL(`${baseUrl}/`, Astro.site).href },
	{ name: '統計', url: new URL(`${baseUrl}/stats/`, Astro.site).href },
	{ name: 'Issue 統計', url: new URL(`${baseUrl}/stats/issues/`, Astro.site).href },
]);

// Tab strip order grouped by university (東大前・後 → 京大前・後 → 東工大前・後)
const TAB_ORDER = [
	'utokyo-zenki',
	'utokyo-kouki',
	'ukyoto-zenki',
	'ukyoto-kouki',
	'titech-zenki',
	'titech-kouki',
];
const orderedTabs = TAB_ORDER.map((id) => stats.categories.find((c) => c.id === id)!).filter(Boolean);

const sortedKinds = [...KIND_META].sort(
	(a, b) => stats.totals.openByKind[b.key] - stats.totals.openByKind[a.key]
);
const topTwoKinds = sortedKinds
	.slice(0, 2)
	.map((k) => `${k.label} ${stats.totals.openByKind[k.key]}`)
	.join(' / ');
const restKindsSummary = [
	...sortedKinds
		.slice(2)
		.filter((k) => stats.totals.openByKind[k.key] > 0)
		.map((k) => `${k.label} ${stats.totals.openByKind[k.key]}`),
	...(stats.totals.openByKind.unclassified > 0
		? [`未分類 ${stats.totals.openByKind.unclassified}`]
		: []),
].join(' ・ ');

function cellStateClass(openCount: number, recorded: boolean): string {
	if (openCount >= 2) return 'c-w2';
	if (openCount === 1) return 'c-w1';
	return recorded ? 'c-ok' : 'c-na';
}
---

<Layout
	title="収録・校閲ステータス（Issue 統計）"
	description="東京大学・京都大学・東京工業大学の過去問アーカイブにおけるGitHub Issue消化状況、種別内訳、および全年度の年度×大問ステータスマップ。"
	jsonLd={breadcrumbJsonLd}
>
	<div class="issues-stats-page" data-issues-stats-root>
		<nav class="breadcrumb" aria-label="パンくずリスト">
			<a href={`${baseUrl}/`}>トップ</a>
			<span class="sep" aria-hidden="true">/</span>
			<a href={`${baseUrl}/stats/`}>統計</a>
			<span class="sep" aria-hidden="true">/</span>
			<span class="current">Issue 統計</span>
		</nav>

		<header class="page-hero">
			<div>
				<h1>
					収録・校閲ステータス <span class="gradient-text">Issue 統計</span>
				</h1>
				<p class="hero-sub">
					GitHub Issues に基づく大学・試験区分別の残タスクと消化進捗（ビルド時スナップショット集計）
				</p>
			</div>
			{checkedAt && (
				<div class="stamp-pill">
					最終集計: <time datetime={stats.generatedAt!}>{checkedAt} JST</time>
				</div>
			)}
		</header>

		{!stats.available && (
			<div class="notice glass" role="status">
				<p>
					ビルド時の Issue スナップショット（<code>issues-by-problem.json</code>）が未取得のため、件数は 0 件として表示されています。最新の状況は{' '}
					<a href={stats.repoIssuesUrl} target="_blank" rel="noopener noreferrer">
						GitHub Issues ↗
					</a>{' '}
					で直接確認できます。
				</p>
			</div>
		)}

		<!-- ===== SECTION A: KPI + 6 CATEGORY CARDS ===== -->
		<section aria-label="全体サマリー指標" class="kpi-row">
			<div class="glass kpi-card">
				<div class="kpi-lbl">残 Open Issue 総数</div>
				<div class="kpi-num amber">
					{stats.available ? stats.totals.open.toLocaleString('ja-JP') : '—'}
				</div>
				<div class="kpi-note">
					{stats.available
						? `問題・区分別 ${stats.totals.problemOpen.toLocaleString('ja-JP')} / 横断・全体 ${stats.totals.generalOpen.toLocaleString('ja-JP')}`
						: 'スナップショット未取得'}
				</div>
			</div>

			<div class="glass kpi-card">
				<div class="kpi-lbl">解決済み (Closed)</div>
				<div class="kpi-num emerald">
					{stats.available ? stats.totals.closed.toLocaleString('ja-JP') : '—'}
				</div>
				<div class="kpi-note">
					{stats.available && stats.totals.completionRate !== null
						? `全体消化率 ${stats.totals.completionRate.toFixed(1)}% (${stats.totals.closed.toLocaleString('ja-JP')} / ${stats.totals.all.toLocaleString('ja-JP')})`
						: '—'}
				</div>
			</div>

			<div class="glass kpi-card">
				<div class="kpi-lbl">種別 (kind) 内訳（Open）</div>
				<div class="kpi-num kind-headline">
					{stats.available ? topTwoKinds : '—'}
				</div>
				<div class="kpi-note">
					{stats.available ? restKindsSummary || '他種別 0' : '—'}
				</div>
			</div>

			<div class="glass kpi-card kpi-clickable">
				<div class="kpi-lbl">横断・Web/CI Issue</div>
				<div class="kpi-num violet">
					{stats.available ? stats.general.openCount.toLocaleString('ja-JP') : '—'}
				</div>
				<div class="kpi-note accent-link">クリックで下部一覧を表示 ↓</div>
				<button
					type="button"
					class="card-stretch-btn"
					data-jump-cat="general"
					aria-label="横断・全体 Issue の一覧を下部で表示"
				></button>
			</div>
		</section>

		<section aria-labelledby="cat-summary-heading" class="cat-summary-section">
			<div class="sec-heading">
				<h2 id="cat-summary-heading">大学・試験区分別サマリー</h2>
				<span>カードを選択すると下の年度別ステータスマップが切り替わります</span>
			</div>

			<div class="grid-6">
				{stats.categories.map((cat, idx) => {
					const rate = cat.completionRate ?? 0;
					const nonZeroKinds = KIND_META.filter((km) => cat.openByKind[km.key] > 0);
					return (
						<article
							class:list={['univ-card', 'glass', { 'active-cat': idx === 0 }]}
							data-cat-card={cat.id}
							style={`background: ${cat.gradient}; border-color: ${cat.border};`}
						>
							<div class="uc-top">
								<h3 class="uc-title" style={`color: ${cat.textAccent};`}>
									{cat.univName} {cat.category === 'zenki' ? '前期' : '後期'}
								</h3>
								<div class="uc-open">
									{stats.available ? cat.openCount.toLocaleString('ja-JP') : '—'}{' '}
									<small>open</small>
								</div>
							</div>

							<div class="uc-prog-meta">
								<span>
									{cat.completionRate !== null ? `消化率 ${cat.completionRate.toFixed(1)}%` : '消化率 —'}
								</span>
								<span>Closed {stats.available ? cat.closedCount.toLocaleString('ja-JP') : '—'}</span>
							</div>
							<div class="uc-bar" aria-hidden="true">
								<div class="uc-bar-fill" style={`width: ${rate}%; background: ${cat.color};`}></div>
							</div>

							<div class="uc-kinds">
								{nonZeroKinds.length > 0 ? (
									nonZeroKinds.map((km) => (
										<span class="kpill">
											{km.label} {cat.openByKind[km.key]}
										</span>
									))
								) : (
									<span class="kpill muted-pill">Open 種別なし</span>
								)}
								{cat.openByKind.unclassified > 0 && (
									<span class="kpill">未分類 {cat.openByKind.unclassified}</span>
								)}
							</div>

							<div class="uc-foot">
								<a
									href={cat.githubSearchUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="gh-ext-link"
								>
									GitHub検索 ↗
								</a>
								<span class="jump-txt">年度マップを見る ↓</span>
							</div>

							<button
								type="button"
								class="card-stretch-btn"
								data-jump-cat={cat.id}
								aria-label={`${cat.univName} ${cat.catName} の年度マップを表示`}
							></button>
						</article>
					);
				})}
			</div>
		</section>

		<!-- ===== SECTION C: INTERACTIVE CATEGORY EXPLORER ===== -->
		<section aria-labelledby="explorer-heading" class="explorer-section" id="explorer">
			<div class="sec-heading">
				<h2 id="explorer-heading">年度×大問ステータス＆Open Issue 一覧</h2>
				<span>大問セルをクリックすると右の一覧を特定の問題で絞り込めます</span>
			</div>

			<div class="glass explorer-shell">
				<div class="cat-tabs" role="tablist" aria-label="表示区分の切り替え">
					{orderedTabs.map((cat, idx) => (
						<button
							type="button"
							role="tab"
							id={`tab-${cat.id}`}
							aria-controls={`panel-${cat.id}`}
							aria-selected={idx === 0 ? 'true' : 'false'}
							tabindex={idx === 0 ? 0 : -1}
							class:list={['ctab', { active: idx === 0 }]}
							data-tab={cat.id}
						>
							{cat.shortLabel} ({stats.available ? cat.openCount : '—'})
						</button>
					))}
					<button
						type="button"
						role="tab"
						id="tab-general"
						aria-controls="panel-general"
						aria-selected="false"
						tabindex={-1}
						class="ctab"
						data-tab="general"
					>
						横断・全体 ({stats.available ? stats.general.openCount : '—'})
					</button>
				</div>

				<div class="filter-bar" data-filter-bar>
					<div class="kind-filters" role="group" aria-label="指摘種別フィルタ">
						<span class="filter-label">種別:</span>
						<button type="button" class="fbtn active" data-kind-btn="all">すべて</button>
						<button type="button" class="fbtn" data-kind-btn="proof">proof (論証)</button>
						<button type="button" class="fbtn" data-kind-btn="transcription">transcription (文字起こし)</button>
						<button type="button" class="fbtn" data-kind-btn="figure">figure (図表)</button>
						<button type="button" class="fbtn" data-kind-btn="other">その他 (ref / style / 未分類)</button>
					</div>

					<label class="year-toggle">
						<input type="checkbox" data-only-open-years />
						<span>Open がある年度のみ表示</span>
					</label>
				</div>

				<!-- 6 Category Panels -->
				{orderedTabs.map((cat, idx) => {
					const maxCols = Math.max(
						1,
						...cat.decades.flatMap((d) => d.years.map((y) => y.questions.length))
					);
					return (
						<div
							role="tabpanel"
							id={`panel-${cat.id}`}
							aria-labelledby={`tab-${cat.id}`}
							class="explorer-grid"
							data-cat-panel={cat.id}
							hidden={idx !== 0}
						>
							<!-- Left: All-Year x Question Heatmap -->
							<div class="sub-panel matrix-panel">
								<div class="sub-panel-head">
									<strong>
										{cat.univName} {cat.category === 'zenki' ? '前期' : '後期'} マトリクス
									</strong>
									<div class="legend-inline" aria-label="セル凡例">
										<span><i class="lg-box lg-ok"></i>0件</span>
										<span><i class="lg-box lg-w1"></i>1件</span>
										<span><i class="lg-box lg-w2"></i>2件+</span>
										<span><i class="lg-box lg-na"></i>未収録</span>
									</div>
								</div>

								{cat.decades.length === 0 ? (
									<p class="empty-msg">収録データがありません。</p>
								) : (
									cat.decades.map((decade) => (
										<div class="decade-group" data-decade-group>
											<div class="decade-label">{decade.label}</div>
											<div class="matrix-rows" style={`--cat-cols: ${maxCols};`}>
												{decade.years.map((yr) => (
													<div class="m-row" data-year-row={yr.year}>
														<span class="m-year">{yr.year}</span>
														{yr.questions.map((q) => {
															const stClass = cellStateClass(q.openCount, q.recorded);
															const statusText =
																q.openCount > 0
																	? `Open Issue ${q.openCount}件`
																	: q.recorded
																		? 'Open Issue 0件（収録済）'
																		: '未収録';
															return (
																<button
																	type="button"
																	class={`m-cell ${stClass}`}
																	data-cell
																	data-prob-key={q.problemKey}
																	data-prob-label={`${yr.year}年 第${q.question}問`}
																	data-recorded={q.recorded ? '1' : '0'}
																	data-page-href={q.pageHref || ''}
																	data-page-label={q.pageLabel || ''}
																	data-open-all={q.openByFilter.all}
																	data-open-proof={q.openByFilter.proof}
																	data-open-transcription={q.openByFilter.transcription}
																	data-open-figure={q.openByFilter.figure}
																	data-open-other={q.openByFilter.other}
																	title={`${yr.year}年 第${q.question}問 — ${statusText}`}
																	aria-label={`${yr.year}年 第${q.question}問 (${statusText})`}
																>
																	{q.question}
																</button>
															);
														})}
													</div>
												))}
											</div>
										</div>
									))
								)}
								<p class="empty-msg" data-no-years-msg hidden>
									現在のフィルタ条件で Open Issue がある年度はありません。
								</p>
							</div>

							<!-- Right: Sticky Matching Open Issue List -->
							<div class="sub-panel list-panel">
								<div class="sub-panel-head">
									<strong data-list-heading data-default-heading={`${cat.shortLabel} の Open Issue`}>
										{cat.shortLabel} の Open Issue（<span data-visible-count>{cat.openIssues.length}</span>件）
									</strong>
									<button type="button" class="reset-btn" data-cell-reset hidden>
										絞り込み解除 ×
									</button>
								</div>

								<div class="selected-cell-bar" data-cell-bar hidden>
									<span data-cell-bar-text></span>
									<a href="#" class="cell-page-link" data-cell-page-link hidden></a>
								</div>

								<div class="issue-list" data-issue-list>
									{cat.openIssues.map((iss) => (
										<div
											class:list={['iss-item', { 'cat-wide-item': iss.scope === 'category' }]}
											data-issue-item
											data-scope={iss.scope}
											data-prob-key={iss.problemKey || ''}
											data-filter-groups={iss.filterGroups.join(' ')}
										>
											<div class="iss-top">
												<span
													class:list={[
														'prob-badge',
														{ 'badge-cat-wide': iss.scope === 'category' },
													]}
												>
													{iss.badge}
												</span>
												<div class="iss-kinds">
													{iss.kinds.length > 0 ? (
														iss.kinds.map((k) => <span class="kpill">{k}</span>)
													) : (
														<span class="kpill muted-pill">未分類</span>
													)}
												</div>
											</div>

											<div class="iss-title">
												<a href={iss.url} target="_blank" rel="noopener noreferrer" class="iss-gh-link">
													<span class="iss-num">#{iss.number}</span>
													{iss.title} ↗
												</a>
											</div>

											<div class="iss-actions">
												<span class="iss-date">
													{iss.updatedDate ? `更新: ${iss.updatedDate}` : ''}
												</span>
												<div class="iss-links">
													{iss.pageHref && iss.pageLabel && (
														<a href={iss.pageHref}>{iss.pageLabel}</a>
													)}
												</div>
											</div>
										</div>
									))}
								</div>

								<p class="empty-msg" data-empty-msg hidden={cat.openIssues.length > 0}>
									条件に一致する Open Issue はありません。
								</p>
							</div>
						</div>
					);
				})}

				<!-- 7th Tab Panel: General / Repository-Wide Issues -->
				<div
					role="tabpanel"
					id="panel-general"
					aria-labelledby="tab-general"
					class="general-panel-wrap"
					data-cat-panel="general"
					hidden
				>
					<div class="sub-panel">
						<div class="sub-panel-head">
							<strong>
								リポジトリ横断・複数問題まとめ・Web/CI Open Issue（{stats.general.openCount}件）
							</strong>
							<a
								href={stats.general.githubSearchUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="gh-ext-link"
							>
								GitHubで検索（Closed {stats.general.closedCount}件除く） ↗
							</a>
						</div>

						{stats.general.openIssues.length > 0 ? (
							<div class="issue-list general-list">
								{stats.general.openIssues.map((iss) => (
									<div class="iss-item cat-wide-item">
										<div class="iss-top">
											<span class="prob-badge badge-cat-wide">横断・全体</span>
											<div class="iss-kinds">
												{iss.kinds.map((k) => (
													<span class="kpill">{k}</span>
												))}
											</div>
										</div>
										<div class="iss-title">
											<a href={iss.url} target="_blank" rel="noopener noreferrer" class="iss-gh-link">
												<span class="iss-num">#{iss.number}</span>
												{iss.title} ↗
											</a>
										</div>
										{iss.updatedDate && (
											<div class="iss-actions">
												<span class="iss-date">更新: {iss.updatedDate}</span>
											</div>
										)}
									</div>
								))}
							</div>
						) : (
							<p class="empty-msg">現在 Open 状態の横断・全体 Issue はありません。</p>
						)}
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>

<script>
	function initIssuesExplorer() {
		const root = document.querySelector('[data-issues-stats-root]');
		if (!root || root.hasAttribute('data-initialized')) return;
		root.setAttribute('data-initialized', 'true');

		let activeCat = 'utokyo-zenki';
		let activeKind = 'all';
		let onlyOpenYears = false;
		let selectedCellKey: string | null = null;

		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-cat-panel]'));
		const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cat-card]'));
		const filterBar = root.querySelector<HTMLElement>('[data-filter-bar]');
		const kindBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-kind-btn]'));
		const openYearsCheckbox = root.querySelector<HTMLInputElement>('[data-only-open-years]');
		const explorerAnchor = document.getElementById('explorer');

		const validCatIds = new Set(tabs.map((t) => t.dataset.tab!));

		function computeCellClass(count: number, recorded: boolean): string {
			if (count >= 2) return 'c-w2';
			if (count === 1) return 'c-w1';
			return recorded ? 'c-ok' : 'c-na';
		}

		function refreshActivePanel() {
			const panel = root!.querySelector<HTMLElement>(`[data-cat-panel="${activeCat}"]`);
			if (!panel || activeCat === 'general') return;

			// 1. Update matrix cells & year/decade visibility
			let anyYearVisible = false;
			panel.querySelectorAll<HTMLElement>('[data-decade-group]').forEach((decadeEl) => {
				let decadeHasVisibleYear = false;
				decadeEl.querySelectorAll<HTMLElement>('[data-year-row]').forEach((rowEl) => {
					let rowOpenSum = 0;
					rowEl.querySelectorAll<HTMLButtonElement>('[data-cell]').forEach((cell) => {
						const count = Number(cell.dataset[`open${activeKind[0].toUpperCase()}${activeKind.slice(1)}`] ?? '0');
						const recorded = cell.dataset.recorded === '1';
						rowOpenSum += count;
						cell.classList.remove('c-ok', 'c-w1', 'c-w2', 'c-na');
						cell.classList.add(computeCellClass(count, recorded));
						cell.classList.toggle('selected-cell', cell.dataset.probKey === selectedCellKey);
					});
					const showRow = !onlyOpenYears || rowOpenSum > 0;
					rowEl.hidden = !showRow;
					if (showRow) {
						decadeHasVisibleYear = true;
						anyYearVisible = true;
					}
				});
				decadeEl.hidden = !decadeHasVisibleYear;
			});

			const noYearsMsg = panel.querySelector<HTMLElement>('[data-no-years-msg]');
			if (noYearsMsg) noYearsMsg.hidden = anyYearVisible || panel.querySelectorAll('[data-decade-group]').length === 0;

			// 2. Update selected cell banner & reset button
			const resetBtn = panel.querySelector<HTMLButtonElement>('[data-cell-reset]');
			const cellBar = panel.querySelector<HTMLElement>('[data-cell-bar]');
			const cellBarText = panel.querySelector<HTMLElement>('[data-cell-bar-text]');
			const cellPageLink = panel.querySelector<HTMLAnchorElement>('[data-cell-page-link]');
			const headingEl = panel.querySelector<HTMLElement>('[data-list-heading]');

			if (selectedCellKey) {
				const selCell = panel.querySelector<HTMLButtonElement>(`[data-cell][data-prob-key="${selectedCellKey}"]`);
				if (resetBtn) resetBtn.hidden = false;
				if (cellBar && selCell) {
					cellBar.hidden = false;
					if (cellBarText) {
						cellBarText.textContent = `${selCell.dataset.probLabel} で絞り込み中`;
					}
					if (cellPageLink) {
						const href = selCell.dataset.pageHref || '';
						const label = selCell.dataset.pageLabel || '';
						if (href && label) {
							cellPageLink.href = href;
							cellPageLink.textContent = label;
							cellPageLink.hidden = false;
						} else {
							cellPageLink.hidden = true;
						}
					}
				}
			} else {
				if (resetBtn) resetBtn.hidden = true;
				if (cellBar) cellBar.hidden = true;
			}

			// 3. Filter issue items
			let visibleIssues = 0;
			panel.querySelectorAll<HTMLElement>('[data-issue-item]').forEach((item) => {
				const groups = (item.dataset.filterGroups || '').split(' ').filter(Boolean);
				const matchKind = activeKind === 'all' || groups.includes(activeKind);
				const matchCell = !selectedCellKey || item.dataset.probKey === selectedCellKey;
				const show = matchKind && matchCell;
				item.hidden = !show;
				if (show) visibleIssues += 1;
			});

			if (headingEl) {
				const baseHeading = headingEl.dataset.defaultHeading || 'Open Issue';
				const prefix = selectedCellKey ? `${selectedCellKey.replace('/', '年 第')}問 の Open Issue` : baseHeading;
				headingEl.textContent = `${prefix}（${visibleIssues}件）`;
			}

			const emptyMsg = panel.querySelector<HTMLElement>('[data-empty-msg]');
			if (emptyMsg) emptyMsg.hidden = visibleIssues > 0;
		}

		function activateCategory(catId: string, options: { scroll?: boolean; updateHash?: boolean } = {}) {
			if (!validCatIds.has(catId)) return;
			activeCat = catId;
			selectedCellKey = null;

			tabs.forEach((tab) => {
				const isCurrent = tab.dataset.tab === catId;
				tab.classList.toggle('active', isCurrent);
				tab.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
				tab.tabIndex = isCurrent ? 0 : -1;
			});

			panels.forEach((panel) => {
				panel.hidden = panel.dataset.catPanel !== catId;
			});

			cards.forEach((card) => {
				card.classList.toggle('active-cat', card.dataset.catCard === catId);
			});

			if (filterBar) {
				filterBar.hidden = catId === 'general';
			}

			refreshActivePanel();

			if (options.updateHash) {
				history.replaceState(null, '', `#${catId}`);
			}
			if (options.scroll && explorerAnchor) {
				const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				explorerAnchor.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
			}
		}

		// Card jump buttons
		root.querySelectorAll<HTMLButtonElement>('[data-jump-cat]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const target = btn.dataset.jumpCat;
				if (target) activateCategory(target, { scroll: true, updateHash: true });
			});
		});

		// Tab clicks + keyboard left/right navigation
		tabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => {
				if (tab.dataset.tab) activateCategory(tab.dataset.tab, { updateHash: true });
			});
			tab.addEventListener('keydown', (e) => {
				if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
				e.preventDefault();
				const nextIdx = e.key === 'ArrowRight' ? (idx + 1) % tabs.length : (idx - 1 + tabs.length) % tabs.length;
				const nextTab = tabs[nextIdx];
				nextTab.focus();
				if (nextTab.dataset.tab) activateCategory(nextTab.dataset.tab, { updateHash: true });
			});
		});

		// Kind filter buttons
		kindBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				activeKind = btn.dataset.kindBtn || 'all';
				kindBtns.forEach((b) => b.classList.toggle('active', b === btn));
				refreshActivePanel();
			});
		});

		// Year toggle
		if (openYearsCheckbox) {
			openYearsCheckbox.addEventListener('change', () => {
				onlyOpenYears = openYearsCheckbox.checked;
				refreshActivePanel();
			});
		}

		// Matrix cell clicks & reset clicks (event delegation per panel)
		panels.forEach((panel) => {
			panel.addEventListener('click', (e) => {
				const target = e.target as HTMLElement | null;
				if (!target) return;
				const cell = target.closest<HTMLButtonElement>('[data-cell]');
				if (cell) {
					const key = cell.dataset.probKey || null;
					selectedCellKey = selectedCellKey === key ? null : key;
					refreshActivePanel();
					return;
				}
				if (target.closest('[data-cell-reset]')) {
					selectedCellKey = null;
					refreshActivePanel();
				}
			});
		});

		// Initial URL hash support (e.g. /stats/issues/#ukyoto-zenki or #general)
		const initialHash = window.location.hash.replace(/^#/, '');
		if (initialHash && validCatIds.has(initialHash)) {
			activateCategory(initialHash, { scroll: false, updateHash: false });
		} else {
			refreshActivePanel();
		}
	}

	document.addEventListener('astro:page-load', initIssuesExplorer);
</script>

