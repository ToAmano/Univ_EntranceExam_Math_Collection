---
import Layout from '../../layouts/Layout.astro';
import ReasoningDensity from '../../components/ReasoningDensity.astro';
import { readSolutionMetrics, getCategoryMeta, buildProblemUrl } from '../../lib/solution-metrics.mjs';
import { buildBreadcrumbListJsonLd } from '../../utils/seo';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const metricsRes = readSolutionMetrics();
const metrics = metricsRes.data;

const checkedAt = metrics?.generated_at
	? new Date(metrics.generated_at).toLocaleString('ja-JP', {
			timeZone: 'Asia/Tokyo',
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
			hour: '2-digit',
			minute: '2-digit',
		})
	: null;

const breadcrumbJsonLd = buildBreadcrumbListJsonLd([
	{ name: 'トップ', url: new URL(`${baseUrl}/`, Astro.site).href },
	{ name: '統計', url: new URL(`${baseUrl}/stats/`, Astro.site).href },
	{ name: '解答行数の分布', url: new URL(`${baseUrl}/stats/solution-length/`, Astro.site).href },
]);

const CATEGORY_TABS = [
	{ id: 'overall', label: '全体', shortLabel: '全体' },
	{ id: 'utokyo_zenki', label: '東大前期', shortLabel: '東大前' },
	{ id: 'utokyo_kouki', label: '東大後期', shortLabel: '東大後' },
	{ id: 'ukyoto_zenki', label: '京大前期', shortLabel: '京大前' },
	{ id: 'ukyoto_kouki', label: '京大後期', shortLabel: '京大後' },
	{ id: 'titech_zenki', label: '東工大前期', shortLabel: '東工前' },
	{ id: 'titech_kouki', label: '東工大後期', shortLabel: '東工後' },
];

const ERA_CATEGORIES = [
	{ id: 'utokyo_zenki', label: '東大前期', color: '#60a5fa', dash: '' },
	{ id: 'utokyo_kouki', label: '東大後期', color: '#1d4ed8', dash: '5,4' },
	{ id: 'ukyoto_zenki', label: '京大前期', color: '#34d399', dash: '' },
	{ id: 'ukyoto_kouki', label: '京大後期', color: '#047857', dash: '5,4' },
	{ id: 'titech_zenki', label: '東工大前期', color: '#fbbf24', dash: '' },
	{ id: 'titech_kouki', label: '東工大後期', color: '#b45309', dash: '5,4' },
];

const ERA_Y_MAX = metrics?.by_era?.length
	? Math.max(100, Math.ceil(Math.max(...metrics.by_era.flatMap((era: any) =>
		[era.mean, ...ERA_CATEGORIES.map((cat) => era[cat.id] || 0)])) / 25) * 25)
	: 100;

const VARIANT_LABELS: Record<string, string> = {
	common: '共通', new: '新課程', old: '旧課程', ko: '甲', otsu: '乙',
};

function getUnivLabel(univ: string): string {
	switch (univ) {
		case 'utokyo':
			return '東京大学';
		case 'ukyoto':
			return '京都大学';
		case 'titech':
			return '東京工業大学';
		default:
			return univ;
	}
}

function getExamLabel(exam: string): string {
	return exam === 'zenki' ? '前期' : '後期';
}
---

<Layout
	title="解答行数の分布・記述量統計 | 大学入試数学アーカイブ"
	description="東京大学・京都大学・東京工業大学の数学入試問題における解答行数、数式中の等号数、場合分け見出し数の統計と可視化。"
>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

	<div class="metrics-page">
		<nav class="breadcrumb" aria-label="パンくずリスト">
			<a href={`${baseUrl}/`}>トップ</a>
			<span class="sep" aria-hidden="true">&rsaquo;</span>
			<a href={`${baseUrl}/stats/`}>統計</a>
			<span class="sep" aria-hidden="true">&rsaquo;</span>
			<span class="current" aria-current="page">解答行数の分布</span>
		</nav>

		<header class="page-hero">
			<div class="hero-text">
				<div class="hero-badge">DATA & ANALYTICS</div>
				<h1>解答行数の分布・記述量統計</h1>
				<p class="hero-lead">
					TeX原稿から抽出した主解答（<code>\begin&#123;tikzpicture&#125;</code> 図やコメント行を除く実質行数）の分布と時代変遷を示しています。
				</p>
			</div>
			{checkedAt && (
				<div class="hero-meta">
					<span class="meta-label">最終集計</span>
					<time class="meta-time">{checkedAt}</time>
				</div>
			)}
		</header>

		{!metrics ? (
			<div class="empty-state glass">
				<p>統計データ（<code>solution-metrics.json</code>）がまだ生成されていません。</p>
				<p>CI または <code>python3 scratch/generate_solution_metrics.py</code> を実行してください。</p>
			</div>
		) : (
			<>
				<!-- KPI Summary Cards -->
				<section class="kpi-section" aria-label="主要指標">
					<div class="kpi-grid">
						<div class="glass kpi-card highlight">
							<span class="kpi-label">全体 平均行数</span>
							<div class="kpi-value-row">
								<span class="kpi-value">{metrics.overall.mean}</span>
								<span class="kpi-unit">行</span>
							</div>
							<span class="kpi-sub">Q1: {metrics.overall.q1}行 〜 Q3: {metrics.overall.q3}行</span>
						</div>

						<div class="glass kpi-card">
							<span class="kpi-label">中央値（標準的な解答）</span>
							<div class="kpi-value-row">
								<span class="kpi-value">{metrics.overall.median}</span>
								<span class="kpi-unit">行</span>
							</div>
							<span class="kpi-sub">半数の解答が {metrics.overall.median} 行以内に収容</span>
						</div>

						<div class="glass kpi-card">
							<span class="kpi-label">最長解答（最大値）</span>
							<div class="kpi-value-row">
								<span class="kpi-value red-val">{metrics.overall.max}</span>
								<span class="kpi-unit">行</span>
							</div>
							{metrics.rankings.longest[0] && (
								<a
									href={buildProblemUrl(baseUrl, metrics.rankings.longest[0])}
									class="kpi-link"
								>
									{getUnivLabel(metrics.rankings.longest[0].univ)} {metrics.rankings.longest[0].year}年 第{metrics.rankings.longest[0].question}問{metrics.rankings.longest[0].variant !== 'common' ? `（${VARIANT_LABELS[metrics.rankings.longest[0].variant]}）` : ''} &rarr;
								</a>
							)}
						</div>

						<div class="glass kpi-card">
							<span class="kpi-label">最短解答（最小値）</span>
							<div class="kpi-value-row">
								<span class="kpi-value green-val">{metrics.overall.min}</span>
								<span class="kpi-unit">行</span>
							</div>
							{metrics.rankings.shortest[0] && (
								<a
									href={buildProblemUrl(baseUrl, metrics.rankings.shortest[0])}
									class="kpi-link green-link"
								>
									{getUnivLabel(metrics.rankings.shortest[0].univ)} {metrics.rankings.shortest[0].year}年 第{metrics.rankings.shortest[0].question}問{metrics.rankings.shortest[0].variant !== 'common' ? `（${VARIANT_LABELS[metrics.rankings.shortest[0].variant]}）` : ''} &rarr;
								</a>
							)}
						</div>

						<div class="glass kpi-card muted-card">
							<span class="kpi-label">集計対象解答数</span>
							<div class="kpi-value-row">
								<span class="kpi-value">{metrics.overall.valid_solutions}</span>
								<span class="kpi-unit">解答</span>
							</div>
							<span class="kpi-sub">未収録・白紙 {metrics.overall.pending_solutions}ファイルを除く。新旧課程は別解答として数えます。</span>
						</div>
					</div>
				</section>

				<!-- Dimension 1: Distribution Histogram & Box Plot -->
				<section class="panel-section" aria-label="行数分布と箱ひげ図">
					<div class="section-header">
						<h2>1. 解答行数の分布ヒストグラム ＆ 箱ひげ図</h2>
						<p class="section-desc">
							タブで大学・入試区分を切り替えて、記述量の偏りや広がりを比較できます。
						</p>
					</div>

					<div class="tab-strip" role="tablist">
						{CATEGORY_TABS.map((tab, idx) => (
							<button
								type="button"
								role="tab"
								class:list={['tab-button', { active: idx === 0 }]}
								data-category={tab.id}
								aria-selected={idx === 0 ? 'true' : 'false'}
							>
								{tab.label}
							</button>
						))}
					</div>

					{CATEGORY_TABS.map((tab, idx) => {
						const catData = tab.id === 'overall' ? metrics.overall : metrics.categories[tab.id];
						if (!catData) return null;
						const maxHistCount = Math.max(...catData.histogram.map((h: any) => h.count), 1);

						return (
							<div
								class:list={['category-panel', { active: idx === 0 }]}
								id={`cat-panel-${tab.id}`}
								role="tabpanel"
							>
								<!-- Summary mini badges -->
								<div class="cat-summary-bar glass">
									<div class="cat-stat-item">
										<span class="stat-lbl">平均</span>
										<span class="stat-val">{catData.mean} 行</span>
									</div>
									<div class="cat-stat-item">
										<span class="stat-lbl">中央値</span>
										<span class="stat-val">{catData.median} 行</span>
									</div>
									<div class="cat-stat-item">
										<span class="stat-lbl">四分位範囲 (Q1〜Q3)</span>
										<span class="stat-val">{catData.q1} 〜 {catData.q3} 行</span>
									</div>
									<div class="cat-stat-item">
										<span class="stat-lbl">最小 〜 最大</span>
										<span class="stat-val">{catData.min} 〜 {catData.max} 行</span>
									</div>
									<div class="cat-stat-item">
										<span class="stat-lbl">有効解答数</span>
										<span class="stat-val">{catData.count} 解答</span>
									</div>
								</div>

								<!-- SVG Histogram -->
								<div class="chart-container glass">
									<h3 class="chart-title">度数分布（ヒストグラム）</h3>
									<div class="svg-wrap">
										<svg
											viewBox="0 0 800 280"
											class="histogram-svg"
											role="img"
											aria-label={`${tab.label}の解答行数ヒストグラム`}
										>
											<!-- Background Grid -->
											<line x1="60" y1="30" x2="760" y2="30" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
											<line x1="60" y1="85" x2="760" y2="85" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
											<line x1="60" y1="140" x2="760" y2="140" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
											<line x1="60" y1="195" x2="760" y2="195" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
											<line x1="60" y1="230" x2="760" y2="230" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" />

											<!-- Y axis labels -->
											<text x="50" y="35" text-anchor="end" font-size="11" fill="#94a3b8">{maxHistCount}</text>
											<text x="50" y="145" text-anchor="end" font-size="11" fill="#94a3b8">{Math.round(maxHistCount / 2)}</text>
											<text x="50" y="235" text-anchor="end" font-size="11" fill="#94a3b8">0</text>

											<!-- Bars -->
											{catData.histogram.map((bin: any, bIdx: number) => {
												const barW = 70;
												const gap = 16;
												const x = 70 + bIdx * (barW + gap);
												const barH = (bin.count / maxHistCount) * 190;
												const y = 230 - barH;

												return (
													<g class="hist-bar-group" tab-index="0">
														<rect
															x={x}
															y={y}
															width={barW}
															height={barH}
															rx="4"
															class="hist-rect"
														/>
														{bin.count > 0 && (
															<text
																x={x + barW / 2}
																y={y - 6}
																text-anchor="middle"
																font-size="11"
																font-weight="600"
																fill="#e2e8f0"
															>
																{bin.count}
															</text>
														)}
														<text
															x={x + barW / 2}
															y="250"
															text-anchor="middle"
															font-size="11"
															fill="#cbd5e1"
														>
															{bin.bin}
														</text>
														<text
															x={x + barW / 2}
															y="266"
															text-anchor="middle"
															font-size="10"
															fill="#64748b"
														>
															{bin.pct}%
														</text>
													</g>
												);
											})}
										</svg>
									</div>
								</div>

								<!-- SVG Box Plot -->
								<div class="chart-container glass">
									<h3 class="chart-title">五数要約（箱ひげ図）</h3>
									<div class="svg-wrap">
										<svg
											viewBox="0 0 800 130"
											class="boxplot-svg"
											role="img"
											aria-label={`${tab.label}の解答行数箱ひげ図`}
										>
											{(() => {
												const scaleX = (val: number) => 60 + (val / 300) * 700;
												const xMin = scaleX(catData.min);
												const xQ1 = scaleX(catData.q1);
												const xMed = scaleX(catData.median);
												const xQ3 = scaleX(catData.q3);
												const xMax = scaleX(catData.max);
												const yBox = 40;
												const hBox = 36;
												const yMid = yBox + hBox / 2;

												return (
													<>
														<!-- Axis scale -->
														<line x1="60" y1="100" x2="760" y2="100" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" />
														{[0, 50, 100, 150, 200, 250, 300].map((tick) => (
															<g>
																<line x1={scaleX(tick)} y1="100" x2={scaleX(tick)} y2="105" stroke="rgba(255, 255, 255, 0.2)" />
																<text x={scaleX(tick)} y="118" text-anchor="middle" font-size="10" fill="#94a3b8">{tick}行</text>
															</g>
														))}

														<!-- Whiskers -->
														<line x1={xMin} y1={yMid} x2={xQ1} y2={yMid} stroke="#94a3b8" stroke-width="2" />
														<line x1={xQ3} y1={yMid} x2={xMax} y2={yMid} stroke="#94a3b8" stroke-width="2" />
														<!-- Min tick -->
														<line x1={xMin} y1={yMid - 10} x2={xMin} y2={yMid + 10} stroke="#94a3b8" stroke-width="2" />
														<!-- Max tick -->
														<line x1={xMax} y1={yMid - 10} x2={xMax} y2={yMid + 10} stroke="#94a3b8" stroke-width="2" />

														<!-- IQR Box -->
														<rect
															x={xQ1}
															y={yBox}
															width={xQ3 - xQ1}
															height={hBox}
															rx="4"
															class="box-rect"
														/>
														<!-- Median Line -->
														<line x1={xMed} y1={yBox} x2={xMed} y2={yBox + hBox} stroke="#ef4444" stroke-width="3" />

														<!-- Labels -->
														<text x={xMin} y={yBox - 8} text-anchor="middle" font-size="10" fill="#94a3b8">最小 {catData.min}</text>
														<text x={xQ1} y={yBox - 8} text-anchor="middle" font-size="10" fill="#94a3b8">Q1 {catData.q1}</text>
														<text x={xMed} y={yBox + hBox + 16} text-anchor="middle" font-size="11" font-weight="700" fill="#f87171">中央値 {catData.median}</text>
														<text x={xQ3} y={yBox - 8} text-anchor="middle" font-size="10" fill="#94a3b8">Q3 {catData.q3}</text>
														<text x={xMax} y={yBox - 8} text-anchor="middle" font-size="10" fill="#94a3b8">最大 {catData.max}</text>
													</>
												);
											})()}
										</svg>
									</div>
								</div>
							</div>
						);
					})}
				</section>

				<!-- Dimension 2: Longest & Shortest Rankings -->
				<section class="panel-section" aria-label="最長・最短解答ランキング">
					<div class="section-header">
						<h2>2. 最長・最短解答 TOP 10 ランキング</h2>
						<p class="section-desc">
							膨大な論証を要する重量級問題と、鮮やかに解ける短文超簡潔解答の対比です。問題名をクリックすると該当の解答・問題ページへ直接遷移できます。
						</p>
					</div>

					<div class="rankings-grid">
						<!-- Longest Column -->
						<div class="ranking-column glass">
							<div class="column-header longest-header">
								<span class="icon" aria-hidden="true">📜</span>
								<h3>最長解答 TOP 10（記述の重量級）</h3>
							</div>
							<div class="ranking-list">
								{metrics.rankings.longest.map((item: any, idx: number) => {
									return (
										<div class="ranking-card">
											<div class="rank-badge longest-badge">#{idx + 1}</div>
											<div class="rank-info">
												<div class="rank-title-row">
													<a href={buildProblemUrl(baseUrl, item)} class="rank-problem-link">
														{item.year}年 {getUnivLabel(item.univ)} {getExamLabel(item.exam)} 第{item.question}問{item.variant !== 'common' ? `（${VARIANT_LABELS[item.variant]}）` : ''}
													</a>
													<span class="rank-lines-pill longest-pill">{item.lines} 行</span>
												</div>
												{item.tags && item.tags.length > 0 && (
													<div class="tag-row">
														{item.tags.map((tag: string) => (
															<span class="mini-tag">{tag}</span>
														))}
													</div>
												)}
											</div>
										</div>
									);
								})}
							</div>
						</div>

						<!-- Shortest Column -->
						<div class="ranking-column glass">
							<div class="column-header shortest-header">
								<span class="icon" aria-hidden="true">⚡</span>
								<h3>最短解答 TOP 10（鮮やかな簡潔解）</h3>
							</div>
							<div class="ranking-list">
								{metrics.rankings.shortest.map((item: any, idx: number) => {
									return (
										<div class="ranking-card">
											<div class="rank-badge shortest-badge">#{idx + 1}</div>
											<div class="rank-info">
												<div class="rank-title-row">
													<a href={buildProblemUrl(baseUrl, item)} class="rank-problem-link">
														{item.year}年 {getUnivLabel(item.univ)} {getExamLabel(item.exam)} 第{item.question}問{item.variant !== 'common' ? `（${VARIANT_LABELS[item.variant]}）` : ''}
													</a>
													<span class="rank-lines-pill shortest-pill">{item.lines} 行</span>
												</div>
												{item.tags && item.tags.length > 0 && (
													<div class="tag-row">
														{item.tags.map((tag: string) => (
															<span class="mini-tag">{tag}</span>
														))}
													</div>
												)}
											</div>
										</div>
									);
								})}
							</div>
						</div>
					</div>
				</section>

				<!-- Dimension 3: Mathematical Field Comparison -->
				<section class="panel-section" aria-label="数学分野別の記述量比較">
					<div class="section-header">
						<h2>3. 数学分野（Topic）別の記述量比較</h2>
						<p class="section-desc">
							各分野タグ（<code>data/topic_tags.yaml</code> 準拠）ごとの平均行数・中央値・解答数です。タブで大学・入試区分を切り替えて、分野ごとの記述量の違いを比較できます。
						</p>
					</div>

					<div class="tab-strip" role="tablist" aria-label="分野別記述量のカテゴリ選択">
						{CATEGORY_TABS.map((tab, idx) => (
							<button
								type="button"
								role="tab"
								class:list={['field-tab-button', { active: idx === 0 }]}
								data-field-category={tab.id}
								aria-selected={idx === 0 ? 'true' : 'false'}
							>
								{tab.label}
							</button>
						))}
					</div>

					{CATEGORY_TABS.map((tab, idx) => {
						const fields = tab.id === 'overall'
							? metrics.by_field
							: (metrics.categories[tab.id]?.by_field || []);
						const maxMean = fields && fields.length > 0
							? Math.max(...fields.map((f: any) => f.mean), 60)
							: 90;

						return (
							<div
								class:list={['field-category-panel', { active: idx === 0 }]}
								id={`field-panel-${tab.id}`}
								role="tabpanel"
							>
								<div class="table-container glass">
									{!fields || fields.length === 0 ? (
										<div class="empty-panel-msg">
											該当する分野タグのデータがありません。
										</div>
									) : (
										<table class="data-table">
											<thead>
												<tr>
													<th>分野タグ</th>
											<th class="num-col">解答数</th>
													<th class="num-col">平均行数</th>
													<th class="num-col">中央値</th>
													<th>平均記述量バー（相対比較）</th>
													<th class="num-col">最小 〜 最大</th>
												</tr>
											</thead>
											<tbody>
												{fields.map((f: any) => {
													const barWidthPct = Math.min(Math.round((f.mean / maxMean) * 100), 100);
													return (
														<tr>
															<td>
																<span class="field-pill">{f.tag}</span>
															</td>
																<td class="num-col font-mono text-muted">{f.count}解答</td>
															<td class="num-col font-mono font-bold">{f.mean}行</td>
															<td class="num-col font-mono text-muted">{f.median}行</td>
															<td>
																<div class="bar-track">
																	<div class="bar-fill" style={`width: ${barWidthPct}%;`}></div>
																</div>
															</td>
															<td class="num-col font-mono text-xs text-muted">{f.min} 〜 {f.max}行</td>
														</tr>
													);
												})}
											</tbody>
										</table>
									)}
								</div>
							</div>
						);
					})}
				</section>

				<!-- Dimension 4: Historical Era Trends -->
				<section class="panel-section" aria-label="年代別の推移">
					<div class="section-header">
						<h2>4. 年代別の推移（1960年代 〜 2010年代）</h2>
						<p class="section-desc">
							各大学の前期・後期を分けた年代別の平均解答行数です。後期は破線で示します。
						</p>
					</div>

					<div class="chart-container glass">
						<div class="era-legend">
							<span class="legend-item"><span class="legend-dot overall-dot"></span> 全体平均</span>
							{ERA_CATEGORIES.map((cat) => (
								<span class="legend-item"><span class="legend-dot" style={`background:${cat.color}`}></span> {cat.label}</span>
							))}
						</div>

						<div class="svg-wrap">
							<svg
								viewBox="0 0 800 280"
								class="era-svg"
								role="img"
								aria-label="年代別解答行数推移グラフ"
							>
								<!-- Grid Lines -->
								<line x1="60" y1="30" x2="760" y2="30" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
								<line x1="60" y1="80" x2="760" y2="80" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
								<line x1="60" y1="130" x2="760" y2="130" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
								<line x1="60" y1="180" x2="760" y2="180" stroke="rgba(255, 255, 255, 0.08)" stroke-dasharray="4" />
								<line x1="60" y1="230" x2="760" y2="230" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" />

								<!-- Y axis labels -->
								<text x="50" y="35" text-anchor="end" font-size="11" fill="#94a3b8">{ERA_Y_MAX}行</text>
								<text x="50" y="85" text-anchor="end" font-size="11" fill="#94a3b8">{ERA_Y_MAX * 0.75}行</text>
								<text x="50" y="135" text-anchor="end" font-size="11" fill="#94a3b8">{ERA_Y_MAX * 0.5}行</text>
								<text x="50" y="185" text-anchor="end" font-size="11" fill="#94a3b8">{ERA_Y_MAX * 0.25}行</text>
								<text x="50" y="235" text-anchor="end" font-size="11" fill="#94a3b8">0行</text>

								{(() => {
									const eraScaleX = (idx: number) => 110 + idx * 125;
									const eraScaleY = (val: number | null) => {
										if (val === null) return 230;
										return 230 - (val / ERA_Y_MAX) * 200;
									};

									const overallPoints = metrics.by_era.map((e: any, i: number) => `${eraScaleX(i)},${eraScaleY(e.mean)}`).join(' ');

									return (
										<>
											<!-- Polyline paths -->
											{ERA_CATEGORIES.map((cat) => (
												<polyline
													points={metrics.by_era.map((e: any, i: number) => e[cat.id] == null ? null : `${eraScaleX(i)},${eraScaleY(e[cat.id])}`).filter(Boolean).join(' ')}
													fill="none" stroke={cat.color} stroke-width="2.5" stroke-dasharray={cat.dash || undefined}
												/>
											))}
											<polyline points={overallPoints} fill="none" stroke="#f8fafc" stroke-width="3" stroke-dasharray="6,4" />

											<!-- Dots and X Axis Labels -->
											{metrics.by_era.map((e: any, i: number) => {
												const cx = eraScaleX(i);
												return (
													<g>
														<text x={cx} y="252" text-anchor="middle" font-size="11" font-weight="600" fill="#e2e8f0">
															{e.era}
														</text>
														<text x={cx} y="268" text-anchor="middle" font-size="10" fill="#94a3b8">
															({e.count}解答)
														</text>

														<!-- Overall dot -->
														<circle cx={cx} cy={eraScaleY(e.mean)} r="4" fill="#f8fafc" />
														<text x={cx} y={eraScaleY(e.mean) - 8} text-anchor="middle" font-size="10" font-weight="700" fill="#f8fafc">
															{e.mean}
														</text>

														<!-- Univ dots -->
														{ERA_CATEGORIES.map((cat) => e[cat.id] == null ? null : (
															<circle cx={cx} cy={eraScaleY(e[cat.id])} r="3" fill={cat.color} />
														))}
													</g>
												);
											})}
										</>
									);
								})()}
							</svg>
						</div>
					</div>

					<div class="section-header">
						<h3>年度ごとの解答ボリューム</h3>
						<p class="section-desc">前期・後期と、新旧課程・甲乙を分けて集計しています。共通問題の解答は該当する両区分に含めます。収録済み解答だけの合計であり、各試験の全問が揃っていることを示す値ではありません。</p>
					</div>
					{ERA_CATEGORIES.map((cat) => {
						const years = (metrics.by_year || []).filter((item: any) => item.category === cat.id);
						return (
							<details class="glass yearly-details">
								<summary>{cat.label}（{years.length}区分）</summary>
								<div class="table-container">
									<table class="data-table">
										<thead><tr><th>年度</th><th>区分</th><th class="num-col">解答数</th><th class="num-col">合計行数</th><th class="num-col">平均行数</th></tr></thead>
										<tbody>
											{years.map((item: any) => (
												<tr><td>{item.year}年</td><td>{VARIANT_LABELS[item.variant] || item.variant}</td><td class="num-col">{item.count}問</td><td class="num-col">{item.total_lines}行</td><td class="num-col">{item.mean == null ? '—' : `${item.mean}行`}</td></tr>
											))}
										</tbody>
									</table>
								</div>
							</details>
						);
					})}
				</section>

				<!-- Methodology & Notes -->
				<section class="panel-section methodology-section" aria-label="集計方法と注記">
					<div class="section-header">
						<h2>5. 集計基準・行数算出仕様</h2>
					</div>
					<div class="methodology-card glass">
						<ul>
							<li>
								<strong>主解答の抽出:</strong> TeX 原稿内の <code>&#123;\bf [解答]&#125;</code>（または <code>\begin&#123;document&#125;</code>）から、次の見出し（<code>[別解]</code>、<code>[解説]</code>）または <code>\end&#123;document&#125;</code> の直前までのブロックを行数の対象としています。
							</li>
							<li>
								<strong>除外対象:</strong> <code>\begin&#123;tikzpicture&#125; ... \end&#123;tikzpicture&#125;</code> の描画コード、空行、コメント行（<code>% ...</code>）、および改ページ・書式マクロ（<code>\newpage</code>, <code>\casesend</code>, <code>\vspace</code>, <code>\rhead</code> 等）は行数カウントから完全に除外しています。
							</li>
							<li>
												<strong>未収録・白紙問題の除外:</strong> 手書き原稿が空欄、白紙、未対応注釈のみ、または <code>$\cdots$(答)</code> などの答えのみで途中論証のないファイル（計 {metrics.overall.pending_solutions}件）は、統計の歪みを防ぐため自動検出して分布・平均値計算から除外しています。
							</li>
							<li>
								<strong>区分別・年度別集計:</strong> 解答原稿の <code>新課程</code>・<code>旧課程</code>・<code>甲</code>・<code>乙</code> 見出しで区分し、共通解答は双方の合計に含めています。解答が未収録の区分は0問として示します。
							</li>
							<li>
								<strong>自動更新:</strong> GitHub Actions のデプロイパイプラインにより、TeX ソースコードの更新に合わせて自動的に再走査・再集計されます。
							</li>
						</ul>
					</div>
				</section>

				<ReasoningDensity />
			</>
		)}
	</div>

	<script>
		function setupCategoryTabs() {
			const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
			const panels = document.querySelectorAll<HTMLElement>('.category-panel');

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const targetCat = btn.getAttribute('data-category');
					if (!targetCat) return;

					buttons.forEach((b) => {
						const isActive = b === btn;
						b.classList.toggle('active', isActive);
						b.setAttribute('aria-selected', isActive ? 'true' : 'false');
					});

					panels.forEach((p) => {
						const isTarget = p.id === `cat-panel-${targetCat}`;
						p.classList.toggle('active', isTarget);
					});
				});
			});
		}

		function setupFieldTabs() {
			const buttons = document.querySelectorAll<HTMLButtonElement>('.field-tab-button');
			const panels = document.querySelectorAll<HTMLElement>('.field-category-panel');

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const targetCat = btn.getAttribute('data-field-category');
					if (!targetCat) return;

					buttons.forEach((b) => {
						const isActive = b === btn;
						b.classList.toggle('active', isActive);
						b.setAttribute('aria-selected', isActive ? 'true' : 'false');
					});

					panels.forEach((p) => {
						const isTarget = p.id === `field-panel-${targetCat}`;
						p.classList.toggle('active', isTarget);
					});
				});
			});
		}

		function initTabs() {
			setupCategoryTabs();
			setupFieldTabs();
		}

		initTabs();
		document.addEventListener('astro:page-load', initTabs);
	</script>
</Layout>

