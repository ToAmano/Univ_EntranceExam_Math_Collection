---
import Layout from '../layouts/Layout.astro';
import NewsText from '../components/NewsText.astro';
import { getMergedNews } from '../lib/news';

const news = await getMergedNews();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const newsByDate = new Map<string, typeof news>();
for (const item of news) {
	if (!newsByDate.has(item.date)) newsByDate.set(item.date, []);
	newsByDate.get(item.date)!.push(item);
}
---

<Layout title="更新情報" description="解答の追加・更新やサイトの変更履歴の一覧です。">
	<div class="container">
		<nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
			<a href={`${baseUrl}/`} style="color: var(--primary); text-decoration: none; font-size: 0.9rem;">← トップへ戻る</a>
		</nav>

		<header style="margin-bottom: 2.5rem;">
			<h1 style="font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem;">更新情報</h1>
			<p style="color: var(--text-muted); margin: 0;">解答の追加・更新、サイトの変更履歴です。</p>
		</header>

		<div class="news-days">
			{Array.from(newsByDate, ([date, items], index) => (
				<details class="glass news-day" id={date} open={index < 3}>
					<summary><span>{date}</span><span class="day-count">{items.length}件</span></summary>
					<ul>
						{items.map((item) => <li><NewsText item={item} baseUrl={baseUrl} /></li>)}
					</ul>
				</details>
			))}
		</div>

		{news.length === 0 && <p style="color: var(--text-muted);">まだ更新情報はありません。</p>}
	</div>
</Layout>

<script>
	function openTargetNewsDay() {
		const rawHash = window.location.hash.replace(/^#/, '');
		if (!rawHash) return;
		let id: string;
		try {
			id = decodeURIComponent(rawHash);
		} catch {
			return;
		}
		const target = document.getElementById(id);
		const details = target?.closest('details.news-day') as HTMLDetailsElement | null;
		if (!details) return;
		details.open = true;
		details.scrollIntoView({ block: 'start' });
	}

	document.addEventListener('astro:page-load', openTargetNewsDay);
	window.addEventListener('hashchange', openTargetNewsDay);
</script>

<style>
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
	}
	.news-days { display: flex; flex-direction: column; gap: .75rem; }
	.news-day { overflow: hidden; scroll-margin-top: 1.5rem; }
	.news-day:target { border-color: rgba(96, 165, 250, 0.5); }
	.news-day summary { display: flex; align-items: center; gap: .65rem; padding: .8rem 1.2rem; cursor: pointer; font-weight: 700; font-variant-numeric: tabular-nums; }
	.news-day summary:hover { color: var(--primary); }
	.day-count { color: var(--text-muted); font-size: .78rem; font-weight: 500; }
	.news-day ul { margin: 0; padding: 0 1.2rem .8rem; list-style: none; }
	.news-day li { padding: .55rem 0; border-top: 1px solid var(--glass-border); color: var(--text-main); font-size: .91rem; }

	@media (max-width: 640px) {
		.container {
			padding: 1.5rem 1rem 3rem;
		}
	}
</style>
