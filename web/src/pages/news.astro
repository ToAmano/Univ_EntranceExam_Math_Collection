---
import Layout from '../layouts/Layout.astro';
import { getMergedNews } from '../lib/news';

const news = await getMergedNews();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="更新情報" description="解答の追加・更新やサイトの変更履歴の一覧です。">
	<div class="container">
		<nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
			<a href={`${baseUrl}/`} style="color: var(--primary); text-decoration: none; font-size: 0.9rem;">← トップへ戻る</a>
		</nav>

		<header style="margin-bottom: 2.5rem;">
			<h1 style="font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem;">更新情報</h1>
			<p style="color: var(--text-muted); margin: 0;">解答の追加・更新、サイトの変更履歴です。</p>
		</header>

		<ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem;">
			{news.map((item) => (
				<li class="glass" style="padding: 1rem 1.25rem; border-radius: 12px; display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap;">
					<span style="font-size: 0.85rem; color: var(--text-muted); font-variant-numeric: tabular-nums; flex-shrink: 0;">{item.date}</span>
					<span style="color: var(--text-main);">{item.title}</span>
				</li>
			))}
		</ul>

		{news.length === 0 && <p style="color: var(--text-muted);">まだ更新情報はありません。</p>}
	</div>
</Layout>

<style>
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
	}
</style>
