---
import { TOPIC_TAGS } from '../lib/tags';

export interface Props {
	solutions: any[];
	baseUrl: string;
}

const { solutions, baseUrl } = Astro.props;

// 6区分メタデータ定義
const CATEGORIES = [
	{ id: 'all', label: '全体', univ: 'all', short: '全体' },
	{ id: 'utokyo-zenki', label: '東大 前期', univ: 'utokyo', short: '東大前' },
	{ id: 'utokyo-kouki', label: '東大 後期', univ: 'utokyo', short: '東大後' },
	{ id: 'ukyoto-zenki', label: '京大 前期', univ: 'ukyoto', short: '京大前' },
	{ id: 'ukyoto-kouki', label: '京大 後期', univ: 'ukyoto', short: '京大後' },
	{ id: 'titech-zenki', label: '東工大 前期', univ: 'titech', short: '東工前' },
	{ id: 'titech-kouki', label: '東工大 後期', univ: 'titech', short: '東工後' },
] as const;

// 15分野の識別カラー
const TOPIC_COLORS: Record<string, { color: string; border: string; bg: string }> = {
	'積分': { color: '#3b82f6', border: '#60a5fa', bg: 'rgba(59, 130, 246, 0.16)' },
	'方程式・不等式': { color: '#8b5cf6', border: '#a78bfa', bg: 'rgba(139, 92, 246, 0.16)' },
	'微分': { color: '#06b6d4', border: '#22d3ee', bg: 'rgba(6, 182, 212, 0.16)' },
	'数列': { color: '#10b981', border: '#34d399', bg: 'rgba(16, 185, 129, 0.16)' },
	'極限': { color: '#0284c7', border: '#38bdf8', bg: 'rgba(2, 132, 199, 0.16)' },
	'整数': { color: '#a855f7', border: '#c084fc', bg: 'rgba(168, 85, 247, 0.16)' },
	'三角関数': { color: '#f59e0b', border: '#fbbf24', bg: 'rgba(245, 158, 11, 0.16)' },
	'平面図形': { color: '#ec4899', border: '#f472b6', bg: 'rgba(236, 72, 153, 0.16)' },
	'図形と方程式': { color: '#f97316', border: '#fb923c', bg: 'rgba(249, 115, 22, 0.15)' },
	'場合の数・確率': { color: '#14b8a6', border: '#2dd4bf', bg: 'rgba(20, 184, 166, 0.16)' },
	'空間図形': { color: '#f43f5e', border: '#fb7185', bg: 'rgba(244, 63, 94, 0.16)' },
	'指数・対数': { color: '#eab308', border: '#fde047', bg: 'rgba(234, 179, 8, 0.16)' },
	'行列・一次変換': { color: '#6366f1', border: '#818cf8', bg: 'rgba(99, 102, 241, 0.16)' },
	'ベクトル': { color: '#84cc16', border: '#a3e635', bg: 'rgba(132, 204, 22, 0.16)' },
	'複素数平面': { color: '#d946ef', border: '#e879f9', bg: 'rgba(217, 70, 239, 0.16)' },
};

// 幾何定数
const radius = 100;
const strokeWidth = 34;
const circumference = 2 * Math.PI * radius; // 628.318...
const gapLength = 2.5;

// 各カテゴリーごとの集計データオブジェクトを作成
const categoryStats: Record<string, any> = {};

for (const cat of CATEGORIES) {
	categoryStats[cat.id] = {
		id: cat.id,
		label: cat.label,
		totalQuestions: 0,
		taggedQuestions: 0,
		totalOccurrences: 0,
		tagCounts: {} as Record<string, number>,
	};
	for (const tag of TOPIC_TAGS) {
		categoryStats[cat.id].tagCounts[tag] = 0;
	}
}

// solutions を走査して全区分を集計
const solutionItems = solutions.filter((s) => s.data.type === 'solution');

for (const s of solutionItems) {
	// ファイル名または slug から区分判定
	const slug = s.slug || '';
	let catId: string | null = null;
	if (slug.startsWith('utokyo-zenki')) catId = 'utokyo-zenki';
	else if (slug.startsWith('utokyo-kouki')) catId = 'utokyo-kouki';
	else if (slug.startsWith('ukyoto-zenki')) catId = 'ukyoto-zenki';
	else if (slug.startsWith('ukyoto-kouki')) catId = 'ukyoto-kouki';
	else if (slug.startsWith('titech-zenki')) catId = 'titech-zenki';
	else if (slug.startsWith('titech-kouki')) catId = 'titech-kouki';

	categoryStats['all'].totalQuestions++;
	if (catId && categoryStats[catId]) {
		categoryStats[catId].totalQuestions++;
	}

	const tags = s.data.tags ?? [];
	if (tags.length > 0) {
		categoryStats['all'].taggedQuestions++;
		if (catId && categoryStats[catId]) {
			categoryStats[catId].taggedQuestions++;
		}

		for (const tag of tags) {
			if (categoryStats['all'].tagCounts[tag] !== undefined) {
				categoryStats['all'].tagCounts[tag]++;
				categoryStats['all'].totalOccurrences++;
			}
			if (catId && categoryStats[catId]?.tagCounts[tag] !== undefined) {
				categoryStats[catId].tagCounts[tag]++;
				categoryStats[catId].totalOccurrences++;
			}
		}
	}
}

// 各区分ごとのランキング・ドーナツセグメントの事前計算
const categoryDataset: Record<string, any> = {};

for (const cat of CATEGORIES) {
	const cData = categoryStats[cat.id];
	const hasTags = cData.taggedQuestions > 0;

	const ranked = TOPIC_TAGS.map((tag) => {
		const count = cData.tagCounts[tag] ?? 0;
		const share = cData.totalOccurrences > 0 ? (count / cData.totalOccurrences) * 100 : 0;
		const rate = cData.taggedQuestions > 0 ? (count / cData.taggedQuestions) * 100 : 0;
		return {
			tag,
			count,
			share,
			rate,
			relShare: 0,
			relRate: 0,
			color: TOPIC_COLORS[tag]?.color ?? '#60a5fa',
			border: TOPIC_COLORS[tag]?.border ?? '#93c5fd',
		};
	}).sort((a, b) => b.count - a.count);

	// 最大値を基準とした相対幅（1位を100%として視覚的に分布を明確化）
	const maxShare = ranked[0]?.share || 1;
	const maxRate = ranked[0]?.rate || 1;
	for (const item of ranked) {
		item.relShare = maxShare > 0 ? (item.share / maxShare) * 100 : 0;
		item.relRate = maxRate > 0 ? (item.rate / maxRate) * 100 : 0;
	}

	let accumulatedOffset = 0;
	const segments = ranked.map((item) => {
		const rawLength = (item.share / 100) * circumference;
		const dashLength = item.count > 0 ? Math.max(0, rawLength - gapLength) : 0;
		const dashOffset = -accumulatedOffset;
		if (item.count > 0) {
			accumulatedOffset += rawLength;
		}
		return {
			tag: item.tag,
			count: item.count,
			share: item.share,
			rate: item.rate,
			color: item.color,
			dashLength,
			dashOffset,
		};
	});

	categoryDataset[cat.id] = {
		id: cat.id,
		label: cat.label,
		hasTags,
		totalQuestions: cData.totalQuestions,
		taggedQuestions: cData.taggedQuestions,
		totalOccurrences: cData.totalOccurrences,
		ranked,
		segments,
	};
}

// 初期表示は「全体（all）」
const initialCat = categoryDataset['all'];
---

<div class="topic-chart-card glass" data-topic-chart-root>
	<!-- 上部ヘッダーと区分切り替えタブ -->
	<div class="chart-top-bar">
		<div class="header-main">
			<div class="badge-row">
				<span class="chart-pill badge-primary">📊 出題分野の分布・比率</span>
				<span class="chart-pill badge-meta" data-cat-meta-pill>
					{initialCat.label} : タグ付与 {initialCat.taggedQuestions}問 / 延べ {initialCat.totalOccurrences}件
				</span>
			</div>
			<h2 class="chart-title">全体・区分別 分野の割合</h2>
			<p class="chart-desc">
				高校数学の全15分野の出題シェアを可視化しています。上部タブで「大学・試験区分」を切り替えて出題傾向を比較できます。
			</p>
		</div>

		<!-- 表示モード切り替え（シェア % ⇔ 出題率 %） -->
		<div class="mode-toggle-group" role="radiogroup" aria-label="グラフ数値の表示形式">
			<button
				type="button"
				class="mode-btn active"
				data-mode="share"
				role="radio"
				aria-checked="true"
			>
				構成比（シェア %）
			</button>
			<button
				type="button"
				class="mode-btn"
				data-mode="rate"
				role="radio"
				aria-checked="false"
			>
				出題率（問題比 %）
			</button>
		</div>
	</div>

	<!-- 大学・試験区分タブストリップ（全体 ＋ 6区分） -->
	<div class="cat-tab-strip" role="tablist" aria-label="大学・試験区分の切り替え">
		{CATEGORIES.map((cat, idx) => {
			const ds = categoryDataset[cat.id];
			return (
				<button
					type="button"
					role="tab"
					class:list={['cat-tab-btn', { active: idx === 0 }]}
					data-cat-tab={cat.id}
					aria-selected={idx === 0 ? 'true' : 'false'}
				>
					<span class="tab-label">{cat.label}</span>
					{ds.hasTags ? (
						<span class="tab-badge has-data">{ds.taggedQuestions}問</span>
					) : (
						<span class="tab-badge no-data">準備中</span>
					)}
				</button>
			);
		})}
	</div>

	<!-- メインチャート描画領域 -->
	<div class="chart-body" data-chart-body>
		<!-- グラフ表示コンテナ（データあり時） -->
		<div class="chart-content" data-chart-active-view>
			<!-- 左側：SVG インタラクティブ・ドーナツチャート -->
			<div class="donut-container">
				<div class="donut-wrapper">
					<svg
						viewBox="0 0 280 280"
						class="donut-svg"
						aria-label="分野別構成比ドーナツグラフ"
						role="img"
					>
						<!-- 背景トラック -->
						<circle
							cx="140"
							cy="140"
							r={radius}
							fill="none"
							stroke="rgba(255, 255, 255, 0.05)"
							stroke-width={strokeWidth}
						/>

						<!-- 各分野のセグメント群 -->
						<g data-segments-container>
							{initialCat.segments.filter((seg: any) => seg.count > 0).map((seg: any) => (
								<circle
									class="donut-segment"
									cx="140"
									cy="140"
									r={radius}
									fill="none"
									stroke={seg.color}
									stroke-width={strokeWidth}
									stroke-dasharray={`${seg.dashLength} ${circumference - seg.dashLength}`}
									stroke-dashoffset={seg.dashOffset}
									stroke-linecap="butt"
									transform="rotate(-90 140 140)"
									data-topic-seg={seg.tag}
									data-count={seg.count}
									data-share={seg.share.toFixed(1)}
									data-rate={seg.rate.toFixed(1)}
									data-color={seg.color}
									tabindex="0"
									role="button"
									aria-label={`${seg.tag}: ${seg.count}問 (${seg.share.toFixed(1)}%)`}
								/>
							))}
						</g>
					</svg>

					<!-- ドーナツ中央ラベル -->
					<div class="donut-center" data-donut-center>
						<div class="center-meta" data-center-meta>{initialCat.label}</div>
						<div class="center-title" data-center-title>出題分野</div>
						<div class="center-value" data-center-value>
							<span class="val-num" data-val-num>{initialCat.totalOccurrences}</span>
							<span class="val-unit" data-val-unit>延べ件数</span>
						</div>
						<div class="center-sub" data-center-sub>タグ付与 {initialCat.taggedQuestions} 問中</div>
					</div>
				</div>

				<div class="donut-hint">
					<span class="hint-icon">💡</span> スライスまたは右のバーに触れると詳細を表示
				</div>
			</div>

			<!-- 右側：ランク別プログレスバー一覧 -->
			<div class="ranked-list-container">
				<div class="list-head">
					<span class="lh-rank">順位</span>
					<span class="lh-name">分野名</span>
					<span class="lh-bar">分布グラフ</span>
					<span class="lh-stat" data-lh-stat>構成比</span>
					<span class="lh-count">出題数</span>
				</div>

				<div class="ranked-list" role="list" data-ranked-list>
					{initialCat.ranked.map((item: any, idx: number) => {
						const href = `${baseUrl}/tags/${encodeURIComponent(item.tag)}/`;
						return (
							<a
								href={href}
								class="ranked-item"
								data-topic-item={item.tag}
								data-count={item.count}
								data-share={item.share.toFixed(1)}
								data-rate={item.rate.toFixed(1)}
								data-rel-share={item.relShare.toFixed(1)}
								data-rel-rate={item.relRate.toFixed(1)}
								data-color={item.color}
								role="listitem"
								title={`${item.tag}の過去問一覧を開く`}
							>
								<span class="rank-badge" class:list={[{ 'top-3': idx < 3 && item.count > 0 }]}>
									{idx + 1}
								</span>

								<div class="item-name-cell">
									<span class="color-dot" style={`background: ${item.color};`}></span>
									<span class="item-tag">{item.tag}</span>
								</div>

								<div class="item-bar-cell">
									<div class="bar-track">
										<div
											class="bar-fill"
											style={`width: ${item.relShare}%; background: linear-gradient(90deg, ${item.color}, ${item.border});`}
											data-bar-fill
										></div>
									</div>
								</div>

								<div class="item-stat-cell" data-item-stat>
									<span class="stat-num">{item.share.toFixed(1)}</span>
									<span class="stat-unit">%</span>
								</div>

								<div class="item-count-cell">
									<span class="count-num">{item.count}</span>
									<span class="count-unit">問</span>
								</div>

								<span class="item-arrow">→</span>
							</a>
						);
					})}
				</div>
			</div>
		</div>

		<!-- タグ未付与区分のプレースホルダー案内カード -->
		<div class="no-data-card" data-no-data-card style="display: none;">
			<div class="no-data-icon">🏷️</div>
			<h3 class="no-data-title" data-no-data-title>タグ付与データを準備中です</h3>
			<p class="no-data-desc" data-no-data-desc>
				この区分の過去問への統制語彙タグ付与は現在順次拡大・整備中です。タグ付け完了後に自動で構成比グラフと出題ランキングが表示されます。
			</p>
			<div class="no-data-meta" data-no-data-meta>
				収録過去問数: — 問
			</div>
		</div>
	</div>

	<!-- フッター注釈 -->
	<div class="chart-footer">
		<div class="footer-note">
			<span class="note-icon">ℹ️</span>
			<span data-footer-note-text>
				東大・京大・東工大（前期・後期）の全収録過去問（1,115問）に統制語彙タグが付与されています。総合問題など1問に複数分野が含まれる場合は複数タグが計上されます。
			</span>
		</div>
		<a href={`${baseUrl}/tags/`} class="tags-portal-link">
			全分野タグ一覧を見る <span class="arrow">→</span>
		</a>
	</div>
</div>

<!-- クライアント用事前計算データ埋め込み -->
<script define:vars={{ categoryDataset, circumference, gapLength, baseUrl }}>
	window.__TOPIC_CHART_DATASET__ = categoryDataset;
	window.__TOPIC_CIRCUMFERENCE__ = circumference;
	window.__TOPIC_GAP_LENGTH__ = gapLength;
	window.__TOPIC_BASE_URL__ = baseUrl;
</script>

<script>
	function setupTopicChartWithTabs() {
		const root = document.querySelector('[data-topic-chart-root]');
		if (!root) return;

		const dataset = (window as any).__TOPIC_CHART_DATASET__;
		const circumference = (window as any).__TOPIC_CIRCUMFERENCE__ || 628.318;
		const baseUrl = (window as any).__TOPIC_BASE_URL__ || '';
		const radius = 100;
		const strokeWidth = 34;

		if (!dataset) return;

		const catTabs = root.querySelectorAll<HTMLButtonElement>('[data-cat-tab]');
		const modeBtns = root.querySelectorAll<HTMLButtonElement>('.mode-btn');
		const metaPill = root.querySelector<HTMLElement>('[data-cat-meta-pill]');
		const chartActiveView = root.querySelector<HTMLElement>('[data-chart-active-view]');
		const noDataCard = root.querySelector<HTMLElement>('[data-no-data-card]');
		const noDataTitle = root.querySelector<HTMLElement>('[data-no-data-title]');
		const noDataMeta = root.querySelector<HTMLElement>('[data-no-data-meta]');

		const segmentsContainer = root.querySelector<SVGGElement>('[data-segments-container]');
		const rankedListContainer = root.querySelector<HTMLElement>('[data-ranked-list]');
		const statHeader = root.querySelector<HTMLElement>('[data-lh-stat]');

		const centerMeta = root.querySelector<HTMLElement>('[data-center-meta]');
		const centerTitle = root.querySelector<HTMLElement>('[data-center-title]');
		const centerValue = root.querySelector<HTMLElement>('[data-center-value]');
		const centerSub = root.querySelector<HTMLElement>('[data-center-sub]');

		let currentCatId = 'all';
		let currentMode: 'share' | 'rate' = 'share';

		// インタラクションイベントのバインド
		function bindInteractions() {
			const donutSegments = root.querySelectorAll<SVGCircleElement>('[data-topic-seg]');
			const listItems = root.querySelectorAll<HTMLElement>('[data-topic-item]');

			const defaultMeta = dataset[currentCatId]?.label || '全体';
			const defaultTitle = '出題分野';
			const defaultValNum = dataset[currentCatId]?.totalOccurrences || 0;
			const defaultTagged = dataset[currentCatId]?.taggedQuestions || 0;

			function highlight(topic: string | null) {
				if (!topic) {
					donutSegments.forEach((s) => s.classList.remove('dimmed', 'highlighted'));
					listItems.forEach((it) => it.classList.remove('dimmed', 'highlighted'));
					if (centerMeta) centerMeta.textContent = defaultMeta;
					if (centerTitle) {
						centerTitle.textContent = defaultTitle;
						centerTitle.style.color = '';
					}
					if (centerValue) {
						centerValue.innerHTML = `<span class="val-num">${defaultValNum}</span><span class="val-unit">延べ件数</span>`;
					}
					if (centerSub) centerSub.textContent = `タグ付与 ${defaultTagged} 問中`;
					return;
				}

				let targetData: any = null;
				donutSegments.forEach((s) => {
					const match = s.dataset.topicSeg === topic;
					s.classList.toggle('highlighted', match);
					s.classList.toggle('dimmed', !match);
					if (match) {
						targetData = {
							count: s.dataset.count || '0',
							share: s.dataset.share || '0',
							rate: s.dataset.rate || '0',
							color: s.dataset.color || '#60a5fa',
						};
					}
				});

				listItems.forEach((it) => {
					const match = it.dataset.topicItem === topic;
					it.classList.toggle('highlighted', match);
					it.classList.toggle('dimmed', !match);
					if (match && !targetData) {
						targetData = {
							count: it.dataset.count || '0',
							share: it.dataset.share || '0',
							rate: it.dataset.rate || '0',
							color: it.dataset.color || '#60a5fa',
						};
					}
				});

				if (targetData) {
					const val = currentMode === 'share' ? targetData.share : targetData.rate;
					const unit = currentMode === 'share' ? '%（シェア）' : '%（出題率）';
					if (centerMeta) centerMeta.textContent = '分野詳細';
					if (centerTitle) {
						centerTitle.textContent = topic;
						centerTitle.style.color = targetData.color;
					}
					if (centerValue) {
						centerValue.innerHTML = `<span class="val-num" style="color: ${targetData.color};">${val}</span><span class="val-unit">${unit}</span>`;
					}
					if (centerSub) centerSub.textContent = `収録過去問 ${targetData.count} 問`;
				}
			}

			donutSegments.forEach((s) => {
				const topic = s.dataset.topicSeg;
				if (!topic) return;
				s.addEventListener('mouseenter', () => highlight(topic));
				s.addEventListener('focus', () => highlight(topic));
				s.addEventListener('mouseleave', () => highlight(null));
				s.addEventListener('blur', () => highlight(null));
				s.addEventListener('click', () => {
					const matching = root.querySelector<HTMLAnchorElement>(`[data-topic-item="${topic}"]`);
					if (matching) matching.click();
				});
			});

			listItems.forEach((it) => {
				const topic = it.dataset.topicItem;
				if (!topic) return;
				it.addEventListener('mouseenter', () => highlight(topic));
				it.addEventListener('focus', () => highlight(topic));
				it.addEventListener('mouseleave', () => highlight(null));
				it.addEventListener('blur', () => highlight(null));
			});
		}

		// カテゴリー切り替え描画
		function renderCategory(catId: string) {
			currentCatId = catId;
			const data = dataset[catId];
			if (!data) return;

			// タブのアクティブ化
			catTabs.forEach((tab) => {
				const isActive = tab.dataset.catTab === catId;
				tab.classList.toggle('active', isActive);
				tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
			});

			// ヘッダーメタピルの更新
			if (metaPill) {
				metaPill.textContent = data.hasTags
					? `${data.label} : タグ付与 ${data.taggedQuestions.toLocaleString('ja-JP')}問 / 延べ ${data.totalOccurrences.toLocaleString('ja-JP')}件`
					: `${data.label} : 収録 ${data.totalQuestions.toLocaleString('ja-JP')}問（タグ準備中）`;
			}

			// データ有無による表示切り替え
			if (!data.hasTags) {
				if (chartActiveView) chartActiveView.style.display = 'none';
				if (noDataCard) {
					noDataCard.style.display = 'flex';
					if (noDataTitle) noDataTitle.textContent = `${data.label} のタグ付与データを準備中です`;
					if (noDataMeta) noDataMeta.textContent = `総収録問題数: ${data.totalQuestions} 問（東大・京大は順次拡大中）`;
				}
				return;
			}

			if (chartActiveView) chartActiveView.style.display = 'grid';
			if (noDataCard) noDataCard.style.display = 'none';

			// ドーナツ中央ラベルのリセット
			if (centerMeta) centerMeta.textContent = data.label;
			if (centerTitle) {
				centerTitle.textContent = '出題分野';
				centerTitle.style.color = '';
			}
			if (centerValue) {
				centerValue.innerHTML = `<span class="val-num">${data.totalOccurrences}</span><span class="val-unit">延べ件数</span>`;
			}
			if (centerSub) centerSub.textContent = `タグ付与 ${data.taggedQuestions} 問中`;

			// ドーナツ SVG セグメントの再構築
			if (segmentsContainer) {
				segmentsContainer.innerHTML = data.segments
					.map((seg: any) => {
						if (seg.count <= 0) return '';
						return `<circle
							class="donut-segment"
							cx="140"
							cy="140"
							r="${radius}"
							fill="none"
							stroke="${seg.color}"
							stroke-width="${strokeWidth}"
							stroke-dasharray="${seg.dashLength} ${circumference - seg.dashLength}"
							stroke-dashoffset="${seg.dashOffset}"
							stroke-linecap="butt"
							transform="rotate(-90 140 140)"
							data-topic-seg="${seg.tag}"
							data-count="${seg.count}"
							data-share="${seg.share.toFixed(1)}"
							data-rate="${seg.rate.toFixed(1)}"
							data-color="${seg.color}"
							tabindex="0"
							role="button"
							aria-label="${seg.tag}: ${seg.count}問 (${seg.share.toFixed(1)}%)"
						/>`;
					})
					.join('');
			}

			// リストの再構築
			if (rankedListContainer) {
				rankedListContainer.innerHTML = data.ranked
					.map((item: any, idx: number) => {
						const href = `${baseUrl}/tags/${encodeURIComponent(item.tag)}/`;
						const displayVal = currentMode === 'share' ? item.share.toFixed(1) : item.rate.toFixed(1);
						const barWidth = currentMode === 'share' ? item.relShare : item.relRate;
						const top3Class = idx < 3 && item.count > 0 ? 'top-3' : '';

						return `
							<a
								href="${href}"
								class="ranked-item"
								data-topic-item="${item.tag}"
								data-count="${item.count}"
								data-share="${item.share.toFixed(1)}"
								data-rate="${item.rate.toFixed(1)}"
								data-rel-share="${item.relShare.toFixed(1)}"
								data-rel-rate="${item.relRate.toFixed(1)}"
								data-color="${item.color}"
								role="listitem"
								title="${item.tag}の過去問一覧を開く"
							>
								<span class="rank-badge ${top3Class}">
									${idx + 1}
								</span>

								<div class="item-name-cell">
									<span class="color-dot" style="background: ${item.color};"></span>
									<span class="item-tag">${item.tag}</span>
								</div>

								<div class="item-bar-cell">
									<div class="bar-track">
										<div
											class="bar-fill"
											style="width: ${barWidth}%; background: linear-gradient(90deg, ${item.color}, ${item.border});"
											data-bar-fill
										></div>
									</div>
								</div>

								<div class="item-stat-cell" data-item-stat>
									<span class="stat-num">${displayVal}</span>
									<span class="stat-unit">%</span>
								</div>

								<div class="item-count-cell">
									<span class="count-num">${item.count}</span>
									<span class="count-unit">問</span>
								</div>

								<span class="item-arrow">→</span>
							</a>
						`;
					})
					.join('');
			}

			bindInteractions();
		}

		// タブクリックイベント
		catTabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const catId = tab.dataset.catTab;
				if (catId && catId !== currentCatId) {
					renderCategory(catId);
				}
			});
		});

		// モード切り替え（シェア % ⇔ 出題率 %）
		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const mode = btn.dataset.mode as 'share' | 'rate';
				if (!mode || mode === currentMode) return;

				currentMode = mode;
				modeBtns.forEach((b) => {
					const isActive = b === btn;
					b.classList.toggle('active', isActive);
					b.setAttribute('aria-checked', isActive ? 'true' : 'false');
				});

				if (statHeader) {
					statHeader.textContent = currentMode === 'share' ? '構成比' : '出題率';
				}

				// リスト内バーと数値の更新
				const items = root.querySelectorAll<HTMLElement>('[data-topic-item]');
				items.forEach((item) => {
					const share = item.dataset.share || '0';
					const rate = item.dataset.rate || '0';
					const relShare = item.dataset.relShare || '0';
					const relRate = item.dataset.relRate || '0';

					const val = currentMode === 'share' ? share : rate;
					const barVal = currentMode === 'share' ? relShare : relRate;

					const bar = item.querySelector<HTMLElement>('[data-bar-fill]');
					if (bar) {
						bar.style.width = `${Math.min(100, Math.max(0, parseFloat(barVal)))}%`;
					}

					const statEl = item.querySelector<HTMLElement>('[data-item-stat]');
					if (statEl) {
						statEl.innerHTML = `<span class="stat-num">${val}</span><span class="stat-unit">%</span>`;
					}
				});
			});
		});

		// 初回バインド
		bindInteractions();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupTopicChartWithTabs);
	} else {
		setupTopicChartWithTabs();
	}
	document.addEventListener('astro:page-load', setupTopicChartWithTabs);
</script>

