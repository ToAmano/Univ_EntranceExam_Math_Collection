---
export interface TrendPoint {
	date: string;
	label: string;
	count: number;
	cumulative: number;
}

export interface CategoryTrendItem {
	id: string;
	univName: string;
	category: 'zenki' | 'kouki';
	color: string;
	textAccent: string;
	gradient: string;
	border: string;
	completionRate: number | null;
	closedTrend: {
		hasClosedData: boolean;
		recentTotal: number;
		dailyPeak: number;
		cumulativeTotal: number;
		dailySeries: TrendPoint[];
		cumulativeSeries: TrendPoint[];
	};
}

export interface Props {
	categories: CategoryTrendItem[];
	meta: {
		recentDays: number;
		dailyStartDate: string | null;
		cumulativeStartDate: string | null;
		endDate: string | null;
		hasAnyClosedData: boolean;
	};
	available: boolean;
}

const { categories, meta, available } = Astro.props;

const SVG_W = 320;
const SVG_H = 116;
const PAD_L = 8;
const PAD_R = 8;
const PAD_T = 18;
const PAD_B = 20;
const PLOT_W = SVG_W - PAD_L - PAD_R;
const PLOT_H = SVG_H - PAD_T - PAD_B;
const BASE_Y = PAD_T + PLOT_H;

function formatRangeShort(ymd: string | null): string {
	if (!ymd) return '—';
	return `${ymd.slice(0, 4)}/${Number(ymd.slice(5, 7))}/${Number(ymd.slice(8, 10))}`;
}

function buildChartModel(cat: CategoryTrendItem) {
	const trend = cat.closedTrend;
	const daily = trend.dailySeries;
	const cum = trend.cumulativeSeries;
	const dailyMaxY = Math.max(1, trend.dailyPeak);
	const cumMaxY = Math.max(1, trend.cumulativeTotal);
	const dailySlotW = daily.length > 0 ? PLOT_W / daily.length : PLOT_W;
	const barW = Math.max(3.5, dailySlotW * 0.68);
	const dailyMidIdx = Math.max(0, Math.floor((daily.length - 1) / 2));

	const dailyBars = daily.map((pt, i) => {
		const slotX = PAD_L + i * dailySlotW;
		const barX = slotX + (dailySlotW - barW) / 2;
		const rawH = (pt.count / dailyMaxY) * PLOT_H;
		const barH = pt.count > 0 ? Math.max(3, rawH) : 1.5;
		const barY = BASE_Y - barH;
		return {
			slotX: slotX.toFixed(1),
			slotW: dailySlotW.toFixed(1),
			barX: barX.toFixed(1),
			barY: barY.toFixed(1),
			barW: barW.toFixed(1),
			barH: barH.toFixed(1),
			nonZero: pt.count > 0,
			tip: `${pt.date}：+${pt.count}件（累計 ${pt.cumulative}件）`,
		};
	});

	const cumDenom = Math.max(1, cum.length - 1);
	const cumPoints = cum.map((pt, i) => {
		const x = cum.length === 1 ? PAD_L + PLOT_W / 2 : PAD_L + (i / cumDenom) * PLOT_W;
		const y = BASE_Y - (pt.cumulative / cumMaxY) * PLOT_H;
		return { ...pt, x, y };
	});
	const cumPolyline = cumPoints.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
	const cumArea =
		cumPoints.length > 0
			? `M ${cumPoints[0].x.toFixed(1)},${BASE_Y} ` +
				cumPoints.map((p) => `L ${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ') +
				` L ${cumPoints[cumPoints.length - 1].x.toFixed(1)},${BASE_Y} Z`
			: '';
	const cumHitRawW = cumPoints.length > 0 ? PLOT_W / cumPoints.length : PLOT_W;
	const cumHitW = Math.max(1.5, cumHitRawW).toFixed(1);
	const cumHits = cumPoints.map((pt, i) => ({
		x: (PAD_L + i * cumHitRawW).toFixed(1),
		tip: `${pt.date}：累計 ${pt.cumulative}件（当日 +${pt.count}件）`,
	}));
	const cumMidIdx = Math.max(0, Math.floor((cumPoints.length - 1) / 2));

	const lastDaily = daily[daily.length - 1];
	const lastCum = cum[cum.length - 1];
	const defaultDailyReadout = lastDaily
		? `最新 ${lastDaily.date}：+${lastDaily.count}件（累計 ${lastDaily.cumulative}件）`
		: 'データなし';
	const defaultCumReadout = lastCum
		? `最新 ${lastCum.date}：累計 ${lastCum.cumulative}件（当日 +${lastCum.count}件）`
		: 'データなし';

	return {
		cat,
		trend,
		daily,
		dailyMidIdx,
		dailyBars,
		cumPoints,
		cumPolyline,
		cumArea,
		cumHitW,
		cumHits,
		cumMidIdx,
		defaultDailyReadout,
		defaultCumReadout,
	};
}

const cards = categories.map(buildChartModel);

const dailyRangeLabel =
	meta.dailyStartDate && meta.endDate
		? `${formatRangeShort(meta.dailyStartDate)} 〜 ${formatRangeShort(meta.endDate)} (JST)`
		: `直近${meta.recentDays}日 (JST)`;
const cumulativeRangeLabel =
	meta.cumulativeStartDate && meta.endDate
		? `${formatRangeShort(meta.cumulativeStartDate)} 〜 ${formatRangeShort(meta.endDate)} (JST)`
		: '全期間 (JST)';
---

<section aria-labelledby="closed-trends-heading" class="closed-trends-section" data-closed-trends>
	<div class="trends-header">
		<div class="sec-heading trends-head">
			<h2 id="closed-trends-heading">Closed Issue 消化推移（6区分）</h2>
			<div class="trend-mode-tabs" role="group" aria-label="推移グラフ表示切り替え">
				<button
					type="button"
					class="tmode-btn active"
					data-trend-mode-btn="daily"
					aria-pressed="true"
				>
					日別（直近{meta.recentDays}日）
				</button>
				<button
					type="button"
					class="tmode-btn"
					data-trend-mode-btn="cumulative"
					aria-pressed="false"
				>
					累計（全期間）
				</button>
			</div>
		</div>
		<p class="trends-sub" data-trends-subtitle="daily">
			直近 {meta.recentDays} 日間の日別解決件数（{dailyRangeLabel}・縦軸は区分別スケール）
		</p>
		<p class="trends-sub" data-trends-subtitle="cumulative" hidden>
			全期間の累計解決件数（{cumulativeRangeLabel}・縦軸は区分別スケール）
		</p>
	</div>

	{!available || !meta.hasAnyClosedData ? (
		<div class="glass trends-empty">
			<p>
				{available
					? 'Closed 済みの Issue データがまだありません。'
					: 'スナップショット未取得のため推移データを表示できません。'}
			</p>
		</div>
	) : (
		<div class="grid-6 trends-grid">
			{cards.map((m) => {
				const { cat, trend, daily, dailyMidIdx, dailyBars, cumPoints, cumPolyline, cumArea, cumHitW, cumHits, cumMidIdx, defaultDailyReadout, defaultCumReadout } = m;
				const examLabel = cat.category === 'zenki' ? '前期' : '後期';
				const lastCumPt = cumPoints[cumPoints.length - 1];
				return (
					<article
						class="trend-card glass"
						style={`background: ${cat.gradient}; border-color: ${cat.border};`}
						data-trend-card={cat.id}
					>
						<div class="tc-top">
							<h3 class="tc-title" style={`color: ${cat.textAccent};`}>
								{cat.univName} {examLabel}
							</h3>
							<div class="tc-stat" data-trend-view="daily">
								<strong style={`color: ${cat.textAccent};`}>+{trend.recentTotal}</strong>
								<span>件 / 最大 {trend.dailyPeak}/日</span>
							</div>
							<div class="tc-stat" data-trend-view="cumulative" hidden>
								<strong style={`color: ${cat.textAccent};`}>{trend.cumulativeTotal}</strong>
								<span>件累計</span>
							</div>
						</div>

						<!-- Daily Bars (Recent N days) -->
						<div class="tc-svg-wrap" data-trend-view="daily">
							<svg
								viewBox={`0 0 ${SVG_W} ${SVG_H}`}
								class="trend-svg"
								role="img"
								aria-label={`${cat.univName} ${examLabel} 直近${meta.recentDays}日の日別 Closed Issue 件数`}
							>
								<line x1={PAD_L} y1={PAD_T} x2={SVG_W - PAD_R} y2={PAD_T} class="t-grid" />
								<line
									x1={PAD_L}
									y1={PAD_T + PLOT_H / 2}
									x2={SVG_W - PAD_R}
									y2={PAD_T + PLOT_H / 2}
									class="t-grid"
								/>
								<line x1={PAD_L} y1={BASE_Y} x2={SVG_W - PAD_R} y2={BASE_Y} class="t-axis" />
								<text x={PAD_L} y={PAD_T - 5} class="t-ymax">
									peak {trend.dailyPeak}件
								</text>

								{dailyBars.map((b) => (
									<g>
										<rect
											x={b.barX}
											y={b.barY}
											width={b.barW}
											height={b.barH}
											rx={b.nonZero ? '1.5' : '0'}
											fill={cat.color}
											fill-opacity={b.nonZero ? '0.9' : '0.22'}
											class="t-bar"
										/>
										<rect
											x={b.slotX}
											y={PAD_T}
											width={b.slotW}
											height={PLOT_H}
											fill="transparent"
											class="t-hit"
											tabindex="0"
											data-trend-hit="daily"
											data-tip={b.tip}
											aria-label={b.tip}
										>
											<title>{b.tip}</title>
										</rect>
									</g>
								))}

								{daily.length > 0 && (
									<g>
										<text x={PAD_L} y={SVG_H - 4} text-anchor="start" class="t-xlabel">
											{daily[0].label}
										</text>
										<text
											x={PAD_L + PLOT_W / 2}
											y={SVG_H - 4}
											text-anchor="middle"
											class="t-xlabel"
										>
											{daily[dailyMidIdx].label}
										</text>
										<text x={SVG_W - PAD_R} y={SVG_H - 4} text-anchor="end" class="t-xlabel">
											{daily[daily.length - 1].label}
										</text>
									</g>
								)}
							</svg>
							<div
								class="tc-readout"
								data-trend-readout="daily"
								data-default-text={defaultDailyReadout}
							>
								{defaultDailyReadout}
							</div>
						</div>

						<!-- Cumulative Line + Area (Full Range) -->
						<div class="tc-svg-wrap" data-trend-view="cumulative" hidden>
							<svg
								viewBox={`0 0 ${SVG_W} ${SVG_H}`}
								class="trend-svg"
								role="img"
								aria-label={`${cat.univName} ${examLabel} 全期間の累計 Closed Issue 件数`}
							>
								<defs>
									<linearGradient id={`cum-grad-${cat.id}`} x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color={cat.color} stop-opacity="0.38" />
										<stop offset="100%" stop-color={cat.color} stop-opacity="0.03" />
									</linearGradient>
								</defs>
								<line x1={PAD_L} y1={PAD_T} x2={SVG_W - PAD_R} y2={PAD_T} class="t-grid" />
								<line
									x1={PAD_L}
									y1={PAD_T + PLOT_H / 2}
									x2={SVG_W - PAD_R}
									y2={PAD_T + PLOT_H / 2}
									class="t-grid"
								/>
								<line x1={PAD_L} y1={BASE_Y} x2={SVG_W - PAD_R} y2={BASE_Y} class="t-axis" />
								<text x={PAD_L} y={PAD_T - 5} class="t-ymax">
									計 {trend.cumulativeTotal}件
								</text>

								{cumPoints.length > 0 && (
									<g>
										<path d={cumArea} fill={`url(#cum-grad-${cat.id})`} />
										{cumPoints.length > 1 && (
											<polyline
												fill="none"
												stroke={cat.color}
												stroke-width="2.2"
												stroke-linejoin="round"
												stroke-linecap="round"
												points={cumPolyline}
											/>
										)}
										{lastCumPt && (
											<circle
												cx={lastCumPt.x.toFixed(1)}
												cy={lastCumPt.y.toFixed(1)}
												r="3.2"
												fill={cat.color}
												stroke="#0f172a"
												stroke-width="1.2"
											/>
										)}
									</g>
								)}

								{cumHits.map((h) => (
									<rect
										x={h.x}
										y={PAD_T}
										width={cumHitW}
										height={PLOT_H}
										fill="transparent"
										class="t-hit"
										data-trend-hit="cumulative"
										data-tip={h.tip}
										aria-label={h.tip}
									>
										<title>{h.tip}</title>
									</rect>
								))}

								{cumPoints.length > 0 && (
									<g>
										<text x={PAD_L} y={SVG_H - 4} text-anchor="start" class="t-xlabel">
											{cumPoints[0].label}
										</text>
										<text
											x={PAD_L + PLOT_W / 2}
											y={SVG_H - 4}
											text-anchor="middle"
											class="t-xlabel"
										>
											{cumPoints[cumMidIdx].label}
										</text>
										<text x={SVG_W - PAD_R} y={SVG_H - 4} text-anchor="end" class="t-xlabel">
											{cumPoints[cumPoints.length - 1].label}
										</text>
									</g>
								)}
							</svg>
							<div
								class="tc-readout"
								data-trend-readout="cumulative"
								data-default-text={defaultCumReadout}
							>
								{defaultCumReadout}
							</div>
						</div>
					</article>
				);
			})}
		</div>
	)}
</section>

<script is:inline>
	(() => {
		const root = document.querySelector('[data-closed-trends]');
		if (!root) return;

		const modeButtons = [...root.querySelectorAll('[data-trend-mode-btn]')];
		const subtitles = [...root.querySelectorAll('[data-trends-subtitle]')];
		const views = [...root.querySelectorAll('[data-trend-view]')];

		function setMode(mode) {
			for (const btn of modeButtons) {
				const active = btn.dataset.trendModeBtn === mode;
				btn.classList.toggle('active', active);
				btn.setAttribute('aria-pressed', String(active));
			}
			for (const sub of subtitles) {
				sub.hidden = sub.dataset.trendsSubtitle !== mode;
			}
			for (const view of views) {
				view.hidden = view.dataset.trendView !== mode;
			}
		}

		for (const btn of modeButtons) {
			btn.addEventListener('click', () => {
				setMode(btn.dataset.trendModeBtn || 'daily');
			});
		}

		for (const card of root.querySelectorAll('[data-trend-card]')) {
			for (const viewKey of ['daily', 'cumulative']) {
				const readout = card.querySelector(`[data-trend-readout="${viewKey}"]`);
				if (!readout) continue;
				const defaultText = readout.dataset.defaultText || '';
				const hits = card.querySelectorAll(`[data-trend-hit="${viewKey}"]`);
				for (const hit of hits) {
					const show = () => {
						if (hit.dataset.tip) readout.textContent = hit.dataset.tip;
					};
					const reset = () => {
						readout.textContent = defaultText;
					};
					hit.addEventListener('pointerenter', show);
					hit.addEventListener('focus', show);
					hit.addEventListener('pointerleave', reset);
					hit.addEventListener('blur', reset);
				}
			}
		}
	})();
</script>

<style>
	.closed-trends-section {
		margin-bottom: 2.5rem;
	}
	.trends-header {
		margin-bottom: 1rem;
	}
	.trends-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin-bottom: 0.25rem;
	}
	.trends-head h2 {
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0;
		color: var(--text-main);
	}
	.trends-sub {
		margin: 0;
		font-size: 0.84rem;
		color: var(--text-muted);
	}
	.trends-sub[hidden] {
		display: none;
	}
	.trend-mode-tabs {
		display: inline-flex;
		gap: 0.35rem;
		padding: 0.25rem;
		border-radius: 10px;
		background: rgba(15, 23, 42, 0.72);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}
	.tmode-btn {
		border: 0;
		background: transparent;
		color: var(--text-muted);
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.4rem 0.75rem;
		border-radius: 7px;
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.tmode-btn:hover {
		color: var(--text-main);
	}
	.tmode-btn.active {
		background: rgba(96, 165, 250, 0.22);
		color: #e0f2fe;
		box-shadow: inset 0 0 0 1px rgba(96, 165, 250, 0.45);
	}
	.trends-empty {
		padding: 1rem 1.25rem;
		border-radius: 14px;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	.trends-empty p {
		margin: 0;
	}
	.trends-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.trend-card {
		padding: 1rem 1.15rem 0.9rem;
		border-radius: 16px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}
	.tc-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
	}
	.tc-title {
		margin: 0;
		font-size: 0.96rem;
		font-weight: 700;
	}
	.tc-stat {
		font-size: 0.76rem;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.tc-stat strong {
		font-size: 0.98rem;
		font-weight: 800;
	}
	.tc-stat[hidden],
	.tc-svg-wrap[hidden] {
		display: none;
	}
	.trend-svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.t-grid {
		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 1;
		stroke-dasharray: 2 3;
	}
	.t-axis {
		stroke: rgba(255, 255, 255, 0.18);
		stroke-width: 1;
	}
	.t-ymax {
		fill: #94a3b8;
		font-size: 9.5px;
		font-variant-numeric: tabular-nums;
	}
	.t-xlabel {
		fill: #94a3b8;
		font-size: 9.5px;
		font-variant-numeric: tabular-nums;
	}
	.t-bar {
		transition: fill-opacity 0.12s ease;
	}
	.t-hit {
		cursor: crosshair;
	}
	.t-hit:focus {
		outline: none;
	}
	.tc-readout {
		margin-top: 0.2rem;
		font-size: 0.74rem;
		color: var(--text-subtle);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-height: 1.15em;
	}
	@media (max-width: 900px) {
		.trends-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.trends-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
