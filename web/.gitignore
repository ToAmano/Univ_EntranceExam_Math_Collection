# build output
dist/

# generated by scratch/tex_to_md.py; deploy-pages.yml regenerates these fresh
# from src/**/*.tex on every push before building, so the committed copy is
# never what actually ships and just bloats repo history (some tikz SVGs are
# 8-15MB and re-commit a full new blob on every regeneration).
src/content/solutions/
public/images/tikz/

# generated by scratch/generate_news.py before each build (see AGENT.md)
src/data/news-auto.json

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Astro cache and env files
.astro/
.env
.env.*
!.env.example

# editor settings
.vscode/
